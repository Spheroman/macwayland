@@ -0,0 +1,125 @@
+/*
+ * Copyright 2026 macwayland contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Drawing a client's frame into the compositor's drawable (macOS, macwl;
+ * docs/gpu.md in macwayland, "Drawing into the drawable").
+ *
+ * Mesa's WSI on a render node presents through a "prime blit": a command
+ * buffer copying the swapchain image into a linear buffer, whose memory is
+ * the dma-buf the compositor gets (here, shared memory: a vkr_shm). The
+ * compositor (macwl-shell) offers a drawable's IOSurface for the frames of
+ * the buffers it has seen committed, named by their shm objects' names.
+ * When such a blit is submitted, the worker first copies the swapchain
+ * image into the drawable (a texture over its IOSurface, imported as a
+ * VkImage), in a submission of its own that takes the blit's waits; the
+ * blit follows as before. The compositor is told the drawable is claimed
+ * as that's submitted, and when its copy is done, and presents it then:
+ * the frame reaches the display without the blit or the compositor's
+ * composite on the way.
+ */
+
+#ifndef VKR_DIRECT_H
+#define VKR_DIRECT_H
+
+#include "vkr_common.h"
+
+#define VKR_DIRECT_KEY_SIZE 64
+
+struct vkr_buffer;
+struct vkr_command_buffer;
+struct vkr_device_memory;
+struct vkr_image;
+struct vkr_queue;
+
+/* What a command buffer copies into an offered buffer: the prime blit. */
+struct vkr_direct_copy {
+   bool valid;
+   VkImage src;
+   VkFormat format;
+   uint32_t width, height;
+   char key[VKR_DIRECT_KEY_SIZE];
+};
+
+#ifdef __APPLE__
+
+/* The key of a buffer bound to `mem` (its shm object's name), if any. */
+void
+vkr_direct_buffer_bound(struct vkr_buffer *buf, struct vkr_device_memory *mem);
+
+/* Note a copy recorded into `cmd`; called before handle replacement. */
+void
+vkr_direct_note_copy(struct vkr_command_buffer *cmd,
+                     struct vkr_image *src,
+                     struct vkr_buffer *dst,
+                     uint32_t region_count,
+                     uint64_t buffer_offset,
+                     uint32_t buffer_row_length,
+                     int32_t image_x,
+                     int32_t image_y,
+                     uint32_t width,
+                     uint32_t height);
+
+/* Before handle replacement: whether submit `i` of these carries a blit for
+ * an offered drawable. Fills `copies` (one per submit; invalid if not). */
+bool
+vkr_direct_find(uint32_t submit_count,
+                const VkCommandBuffer *const *cmd_buffers,
+                const uint32_t *cmd_buffer_counts,
+                struct vkr_direct_copy *copies);
+
+/* Submit (after handle replacement) the drawable copies for `copies`, each
+ * taking its submit's waits and signalling `*signal_out[i]` (a semaphore
+ * the submit is then to wait on instead). Returns false if none was
+ * submitted (then nothing changes). The queue's vk_mutex is held. */
+bool
+vkr_direct_submit(struct vkr_queue *queue,
+                  uint32_t submit_count,
+                  const struct vkr_direct_copy *copies,
+                  const VkSubmitInfo2 *waits,
+                  VkSemaphore *signal_out);
+
+#else
+
+static inline void
+vkr_direct_buffer_bound(UNUSED struct vkr_buffer *buf, UNUSED struct vkr_device_memory *mem)
+{
+}
+
+static inline void
+vkr_direct_note_copy(UNUSED struct vkr_command_buffer *cmd,
+                     UNUSED struct vkr_image *src,
+                     UNUSED struct vkr_buffer *dst,
+                     UNUSED uint32_t region_count,
+                     UNUSED uint64_t buffer_offset,
+                     UNUSED uint32_t buffer_row_length,
+                     UNUSED int32_t image_x,
+                     UNUSED int32_t image_y,
+                     UNUSED uint32_t width,
+                     UNUSED uint32_t height)
+{
+}
+
+static inline bool
+vkr_direct_find(UNUSED uint32_t submit_count,
+                UNUSED const VkCommandBuffer *const *cmd_buffers,
+                UNUSED const uint32_t *cmd_buffer_counts,
+                UNUSED struct vkr_direct_copy *copies)
+{
+   return false;
+}
+
+static inline bool
+vkr_direct_submit(UNUSED struct vkr_queue *queue,
+                  UNUSED uint32_t submit_count,
+                  UNUSED const struct vkr_direct_copy *copies,
+                  UNUSED const VkSubmitInfo2 *waits,
+                  UNUSED VkSemaphore *signal_out)
+{
+   return false;
+}
+
+#endif
+
+#endif /* VKR_DIRECT_H */
