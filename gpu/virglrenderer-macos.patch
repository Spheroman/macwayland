diff --git a/src/venus/vkr_direct.c b/src/venus/vkr_direct.c
new file mode 100644
index 00000000..01ee0353
--- /dev/null
+++ b/src/venus/vkr_direct.c
@@ -0,0 +1,813 @@
+/*
+ * Copyright 2026 macwayland contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* See vkr_direct.h. macOS only. */
+
+/* The system's first: <sys/queue.h> (through Mach's) has list macros of
+ * its own, which Mesa's util/list.h then defines its way. */
+#include <IOSurface/IOSurfaceRef.h>
+#include <fcntl.h>
+#include <libproc.h>
+#include <mach/mach.h>
+#include <objc/message.h>
+#include <objc/runtime.h>
+#include <pthread.h>
+#include <servers/bootstrap.h>
+#include <sys/proc_info.h>
+#include <unistd.h>
+#undef LIST_ENTRY
+#undef LIST_HEAD
+#undef LIST_INIT
+#undef LIST_FIRST
+#undef LIST_NEXT
+#undef LIST_EMPTY
+#undef LIST_FOREACH
+#undef LIST_INSERT_HEAD
+#undef LIST_REMOVE
+
+#include "vkr_direct.h"
+
+#include "vkr_buffer.h"
+#include "vkr_command_buffer.h"
+#include "vkr_device.h"
+#include "vkr_device_memory.h"
+#include "vkr_image.h"
+#include "vkr_queue.h"
+
+/* Messages with macwl-shell (crates/shell, `direct`): fixed layouts, packed
+ * to 4 bytes as Mach messages are. */
+enum {
+   MSG_HELLO = 1,   /* worker → shell; reply port: the worker's */
+   MSG_OFFER = 2,   /* shell → worker */
+   MSG_REVOKE = 3,  /* shell → worker */
+   MSG_CLAIM = 4,   /* worker → shell */
+   MSG_DONE = 5,    /* worker → shell */
+   MSG_REVOKED = 6, /* worker → shell */
+   MSG_REKEY = 7,   /* shell → worker: an offer's keys, as an OFFER without its port */
+};
+
+#define MAX_KEYS 8
+#define MAX_OFFERS 4
+#define MAX_TARGETS 6
+
+#pragma pack(push, 4)
+struct msg_offer {
+   mach_msg_header_t header;
+   mach_msg_body_t body;
+   mach_msg_port_descriptor_t surface;
+   uint64_t id;
+   uint32_t width, height, key_count;
+   char keys[MAX_KEYS][VKR_DIRECT_KEY_SIZE];
+};
+
+struct msg_id {
+   mach_msg_header_t header;
+   uint64_t id;
+   char key[VKR_DIRECT_KEY_SIZE];
+};
+#pragma pack(pop)
+
+struct offer {
+   bool used;
+   bool claimed;
+   uint64_t id;
+   IOSurfaceRef surface;
+   uint32_t width, height, key_count;
+   char keys[MAX_KEYS][VKR_DIRECT_KEY_SIZE];
+};
+
+/* A VkImage over a texture over a drawable's IOSurface (drawables recycle a
+ * few IOSurfaces, so these are kept). */
+struct target {
+   bool used;
+   VkDevice device;
+   struct vn_device_proc_table *vk;
+   IOSurfaceID surface_id;
+   VkFormat format;
+   uint32_t width, height;
+   void *texture; /* id<MTLTexture> */
+   VkImage image;
+   VkDeviceMemory memory;
+   uint64_t last_use;
+   uint32_t in_flight;
+};
+
+/* A copy in flight, waited for by the waiter thread. */
+struct pending {
+   struct list_head head;
+   VkDevice device;
+   struct vn_device_proc_table *vk;
+   VkFence fence;
+   VkCommandPool pool;
+   VkCommandBuffer cmd;
+   uint64_t offer_id;
+   struct target *target;
+};
+
+/* What a queue keeps for its copies. */
+struct queue_state {
+   bool used;
+   VkQueue queue;
+   VkCommandPool pool;
+   VkSemaphore semaphore;
+};
+
+static struct {
+   pthread_mutex_t mutex;
+   pthread_cond_t cond;
+   bool started;
+   /* The channel: the shell's port, ours. */
+   mach_port_t shell;
+   mach_port_t port;
+   time_t tried;
+   struct offer offers[MAX_OFFERS];
+   struct target targets[MAX_TARGETS];
+   struct queue_state queues[4];
+   uint64_t uses;
+   struct list_head pending;
+   /* Command pools are used by the submitter and the waiter: this guards
+    * them. */
+   pthread_mutex_t pool_mutex;
+} direct = {
+   .mutex = PTHREAD_MUTEX_INITIALIZER,
+   .cond = PTHREAD_COND_INITIALIZER,
+   .pool_mutex = PTHREAD_MUTEX_INITIALIZER,
+};
+
+static bool
+trace(void)
+{
+   static int on = -1;
+   if (on < 0)
+      on = getenv("MACWL_DIRECT_TRACE") != NULL;
+   return on;
+}
+
+/* The key of shared memory `fd`: its POSIX shm object's name, which macOS
+ * keeps after unlinking ('s' then the name; as macwl's runtime and
+ * compositor make it). */
+static bool
+shm_key(int fd, char key[VKR_DIRECT_KEY_SIZE])
+{
+   struct pshm_fdinfo info;
+   int n = proc_pidfdinfo(getpid(), fd, PROC_PIDFDPSHMINFO, &info, sizeof(info));
+   if (n != (int)sizeof(info))
+      return false;
+   size_t len = strnlen(info.pshminfo.pshm_name, sizeof(info.pshminfo.pshm_name));
+   if (len == 0 || len >= VKR_DIRECT_KEY_SIZE - 1)
+      return false;
+   memset(key, 0, VKR_DIRECT_KEY_SIZE);
+   key[0] = 's';
+   memcpy(key + 1, info.pshminfo.pshm_name, len);
+   return true;
+}
+
+static void
+send_id(uint32_t msg, uint64_t id, const char *key)
+{
+   if (direct.shell == MACH_PORT_NULL)
+      return;
+   struct msg_id m;
+   memset(&m, 0, sizeof(m));
+   m.header.msgh_bits = MACH_MSGH_BITS(MACH_MSG_TYPE_COPY_SEND, 0);
+   m.header.msgh_size = sizeof(m);
+   m.header.msgh_remote_port = direct.shell;
+   m.header.msgh_id = msg;
+   m.id = id;
+   if (key)
+      memcpy(m.key, key, VKR_DIRECT_KEY_SIZE);
+   kern_return_t kr = mach_msg(&m.header, MACH_SEND_MSG | MACH_SEND_TIMEOUT, sizeof(m), 0,
+                               MACH_PORT_NULL, 100, MACH_PORT_NULL);
+   if (kr != KERN_SUCCESS) {
+      if (trace())
+         vkr_log("direct: send %u failed: %d", msg, kr);
+      if (kr == MACH_SEND_INVALID_DEST) {
+         mach_port_deallocate(mach_task_self(), direct.shell);
+         direct.shell = MACH_PORT_NULL;
+      }
+   }
+}
+
+static void
+drop_offer(struct offer *o)
+{
+   if (o->surface)
+      CFRelease(o->surface);
+   memset(o, 0, sizeof(*o));
+}
+
+/* Messages from the shell. */
+static void *
+receiver(UNUSED void *arg)
+{
+   union {
+      struct msg_offer offer;
+      struct msg_id id;
+      uint8_t bytes[sizeof(struct msg_offer) + 128];
+   } buf;
+   for (;;) {
+      memset(&buf, 0, sizeof(buf));
+      kern_return_t kr = mach_msg(&buf.offer.header, MACH_RCV_MSG, 0, sizeof(buf), direct.port,
+                                  MACH_MSG_TIMEOUT_NONE, MACH_PORT_NULL);
+      if (kr != KERN_SUCCESS) {
+         if (trace())
+            vkr_log("direct: receive failed: %d", kr);
+         if (kr == MACH_RCV_TOO_LARGE)
+            continue;
+         return NULL;
+      }
+      pthread_mutex_lock(&direct.mutex);
+      switch (buf.offer.header.msgh_id) {
+      case MSG_OFFER: {
+         struct msg_offer *m = &buf.offer;
+         IOSurfaceRef surface = IOSurfaceLookupFromMachPort(m->surface.name);
+         mach_port_deallocate(mach_task_self(), m->surface.name);
+         struct offer *slot = NULL;
+         for (int i = 0; i < MAX_OFFERS && !slot; i++) {
+            if (!direct.offers[i].used)
+               slot = &direct.offers[i];
+         }
+         if (!surface || !slot) {
+            if (surface)
+               CFRelease(surface);
+            /* (Not taken: as good as revoked.) */
+            send_id(MSG_REVOKED, m->id, NULL);
+            break;
+         }
+         slot->used = true;
+         slot->claimed = false;
+         slot->id = m->id;
+         slot->surface = surface;
+         slot->width = m->width;
+         slot->height = m->height;
+         slot->key_count = MIN2(m->key_count, MAX_KEYS);
+         memcpy(slot->keys, m->keys, sizeof(slot->keys));
+         if (trace())
+            vkr_log("direct: offer %" PRIu64 " %ux%u, %u keys", m->id, m->width, m->height,
+                    slot->key_count);
+         break;
+      }
+      case MSG_REKEY: {
+         /* (Laid out as an offer, its descriptor empty.) */
+         struct msg_offer *m = &buf.offer;
+         for (int i = 0; i < MAX_OFFERS; i++) {
+            struct offer *o = &direct.offers[i];
+            if (o->used && o->id == m->id) {
+               o->key_count = MIN2(m->key_count, MAX_KEYS);
+               memcpy(o->keys, m->keys, sizeof(o->keys));
+               if (trace())
+                  vkr_log("direct: offer %" PRIu64 " now %u keys", m->id, o->key_count);
+            }
+         }
+         break;
+      }
+      case MSG_REVOKE: {
+         for (int i = 0; i < MAX_OFFERS; i++) {
+            struct offer *o = &direct.offers[i];
+            if (o->used && o->id == buf.id.id && !o->claimed) {
+               drop_offer(o);
+               send_id(MSG_REVOKED, buf.id.id, NULL);
+            }
+         }
+         break;
+      }
+      default:
+         break;
+      }
+      pthread_mutex_unlock(&direct.mutex);
+   }
+}
+
+/* Waits for copies, tells the shell each is done, frees what it used. */
+static void *
+waiter(UNUSED void *arg)
+{
+   pthread_mutex_lock(&direct.mutex);
+   for (;;) {
+      while (list_is_empty(&direct.pending))
+         pthread_cond_wait(&direct.cond, &direct.mutex);
+      struct pending *p = list_first_entry(&direct.pending, struct pending, head);
+      pthread_mutex_unlock(&direct.mutex);
+
+      VkResult r = p->vk->WaitForFences(p->device, 1, &p->fence, VK_TRUE, UINT64_MAX);
+
+      pthread_mutex_lock(&direct.mutex);
+      list_del(&p->head);
+      if (r == VK_SUCCESS)
+         send_id(MSG_DONE, p->offer_id, NULL);
+      else
+         send_id(MSG_REVOKED, p->offer_id, NULL);
+      p->target->in_flight--;
+      pthread_mutex_unlock(&direct.mutex);
+
+      pthread_mutex_lock(&direct.pool_mutex);
+      p->vk->FreeCommandBuffers(p->device, p->pool, 1, &p->cmd);
+      pthread_mutex_unlock(&direct.pool_mutex);
+      p->vk->DestroyFence(p->device, p->fence, NULL);
+      free(p);
+
+      pthread_mutex_lock(&direct.mutex);
+   }
+   return NULL;
+}
+
+/* Connect to the shell, if one listens: its bootstrap name is in
+ * $XDG_RUNTIME_DIR/$WAYLAND_DISPLAY.direct. Called with the mutex held. */
+static void
+ensure_channel(void)
+{
+   if (!direct.started) {
+      list_inithead(&direct.pending);
+      direct.started = true;
+   }
+   if (direct.shell != MACH_PORT_NULL)
+      return;
+   time_t now = time(NULL);
+   if (direct.tried && now - direct.tried < 1)
+      return;
+   direct.tried = now;
+
+   const char *dir = getenv("XDG_RUNTIME_DIR");
+   const char *display = getenv("WAYLAND_DISPLAY");
+   if (!display)
+      return;
+   char path[1024];
+   if (display[0] == '/')
+      snprintf(path, sizeof(path), "%s.direct", display);
+   else if (dir)
+      snprintf(path, sizeof(path), "%s/%s.direct", dir, display);
+   else
+      return;
+   int fd = open(path, O_RDONLY | O_CLOEXEC);
+   if (fd < 0)
+      return;
+   char name[128] = { 0 };
+   ssize_t n = read(fd, name, sizeof(name) - 1);
+   close(fd);
+   while (n > 0 && (name[n - 1] == '\n' || name[n - 1] == 0))
+      name[--n] = 0;
+   if (n <= 0)
+      return;
+
+   mach_port_t shell;
+   if (bootstrap_look_up(bootstrap_port, name, &shell) != KERN_SUCCESS)
+      return;
+   if (direct.port == MACH_PORT_NULL) {
+      if (mach_port_allocate(mach_task_self(), MACH_PORT_RIGHT_RECEIVE, &direct.port) !=
+          KERN_SUCCESS) {
+         mach_port_deallocate(mach_task_self(), shell);
+         return;
+      }
+      pthread_t t;
+      pthread_create(&t, NULL, receiver, NULL);
+      pthread_detach(t);
+      pthread_create(&t, NULL, waiter, NULL);
+      pthread_detach(t);
+   }
+   mach_msg_header_t hello;
+   memset(&hello, 0, sizeof(hello));
+   hello.msgh_bits = MACH_MSGH_BITS(MACH_MSG_TYPE_COPY_SEND, MACH_MSG_TYPE_MAKE_SEND);
+   hello.msgh_size = sizeof(hello);
+   hello.msgh_remote_port = shell;
+   hello.msgh_local_port = direct.port;
+   hello.msgh_id = MSG_HELLO;
+   if (mach_msg(&hello, MACH_SEND_MSG | MACH_SEND_TIMEOUT, sizeof(hello), 0, MACH_PORT_NULL, 100,
+                MACH_PORT_NULL) != KERN_SUCCESS) {
+      mach_port_deallocate(mach_task_self(), shell);
+      return;
+   }
+   direct.shell = shell;
+   if (trace())
+      vkr_log("direct: connected to %s", name);
+}
+
+void
+vkr_direct_buffer_bound(struct vkr_buffer *buf, struct vkr_device_memory *mem)
+{
+   buf->direct_key_valid = false;
+   if (!mem || !mem->shm)
+      return;
+   buf->direct_key_valid = shm_key(mem->shm->fd, buf->direct_key);
+   if (buf->direct_key_valid) {
+      pthread_mutex_lock(&direct.mutex);
+      ensure_channel();
+      pthread_mutex_unlock(&direct.mutex);
+   }
+}
+
+void
+vkr_direct_note_copy(struct vkr_command_buffer *cmd,
+                     struct vkr_image *src,
+                     struct vkr_buffer *dst,
+                     uint32_t region_count,
+                     uint64_t buffer_offset,
+                     uint32_t buffer_row_length,
+                     int32_t image_x,
+                     int32_t image_y,
+                     uint32_t width,
+                     uint32_t height)
+{
+   if (!dst || !dst->direct_key_valid || !src)
+      return;
+   /* The whole image, in one region: the prime blit. (The buffer's layout,
+    * its rows aligned, doesn't matter: the drawable gets an image copy.) */
+   (void)buffer_offset;
+   (void)buffer_row_length;
+   if (region_count != 1 || image_x != 0 || image_y != 0 || width != src->width ||
+       height != src->height)
+      return;
+   if (src->format != VK_FORMAT_B8G8R8A8_UNORM && src->format != VK_FORMAT_B8G8R8A8_SRGB)
+      return;
+   cmd->direct.valid = true;
+   cmd->direct.src = src->base.handle.image;
+   cmd->direct.format = src->format;
+   cmd->direct.width = width;
+   cmd->direct.height = height;
+   memcpy(cmd->direct.key, dst->direct_key, VKR_DIRECT_KEY_SIZE);
+}
+
+/* The offer for a copy, if there is one. Mutex held. */
+static struct offer *
+offer_for(const struct vkr_direct_copy *c)
+{
+   for (int i = 0; i < MAX_OFFERS; i++) {
+      struct offer *o = &direct.offers[i];
+      if (!o->used || o->claimed || o->width != c->width || o->height != c->height)
+         continue;
+      for (uint32_t k = 0; k < o->key_count; k++) {
+         if (!memcmp(o->keys[k], c->key, VKR_DIRECT_KEY_SIZE))
+            return o;
+      }
+   }
+   return NULL;
+}
+
+bool
+vkr_direct_find(uint32_t submit_count,
+                const VkCommandBuffer *const *cmd_buffers,
+                const uint32_t *cmd_buffer_counts,
+                struct vkr_direct_copy *copies)
+{
+   bool any = false;
+   pthread_mutex_lock(&direct.mutex);
+   /* (A shell may come after this worker's buffers did: look again, at most
+    * once a second, once there are buffers to offer for.) */
+   if (direct.started && direct.shell == MACH_PORT_NULL)
+      ensure_channel();
+   bool offered = false;
+   for (int i = 0; i < MAX_OFFERS; i++)
+      offered |= direct.offers[i].used && !direct.offers[i].claimed;
+   for (uint32_t i = 0; i < submit_count; i++) {
+      copies[i].valid = false;
+      if (!offered || any)
+         continue;
+      for (uint32_t j = 0; j < cmd_buffer_counts[i]; j++) {
+         struct vkr_command_buffer *cmd = vkr_command_buffer_from_handle(cmd_buffers[i][j]);
+         if (cmd && cmd->direct.valid && offer_for(&cmd->direct)) {
+            copies[i] = cmd->direct;
+            any = true;
+            break;
+         }
+      }
+   }
+   pthread_mutex_unlock(&direct.mutex);
+   return any;
+}
+
+static void *
+new_texture(IOSurfaceRef surface, VkFormat format, uint32_t width, uint32_t height)
+{
+   /* id<MTLDevice>: KosmicKrisp's, found as it finds it (mtl_device.m: the
+    * first supporting MTLGPUFamilyMetal4), since a texture is a device's. */
+   extern void *MTLCopyAllDevices(void);
+   static void *device;
+   if (!device) {
+      void *all = MTLCopyAllDevices();
+      unsigned long n = ((unsigned long (*)(void *, SEL))objc_msgSend)(all, sel_registerName("count"));
+      for (unsigned long i = 0; i < n && !device; i++) {
+         void *d = ((void *(*)(void *, SEL, unsigned long))objc_msgSend)(
+            all, sel_registerName("objectAtIndex:"), i);
+         if (((BOOL (*)(void *, SEL, long))objc_msgSend)(d, sel_registerName("supportsFamily:"),
+                                                         5002 /* MTLGPUFamilyMetal4 */))
+            device = ((void *(*)(void *, SEL))objc_msgSend)(d, sel_registerName("retain"));
+      }
+      ((void (*)(void *, SEL))objc_msgSend)(all, sel_registerName("release"));
+   }
+   if (!device)
+      return NULL;
+   /* MTLPixelFormatBGRA8Unorm, or its sRGB view: the same bytes. */
+   unsigned long pixel_format = format == VK_FORMAT_B8G8R8A8_SRGB ? 81 : 80;
+   void *desc = ((void *(*)(Class, SEL, unsigned long, unsigned long, unsigned long, BOOL))
+                    objc_msgSend)(objc_getClass("MTLTextureDescriptor"),
+                                  sel_registerName(
+                                     "texture2DDescriptorWithPixelFormat:width:height:mipmapped:"),
+                                  pixel_format, width, height, NO);
+   if (!desc)
+      return NULL;
+   /* ShaderRead | ShaderWrite | RenderTarget */
+   ((void (*)(void *, SEL, unsigned long))objc_msgSend)(desc, sel_registerName("setUsage:"),
+                                                        1 | 2 | 4);
+   return ((void *(*)(void *, SEL, void *, IOSurfaceRef, unsigned long))objc_msgSend)(
+      device, sel_registerName("newTextureWithDescriptor:iosurface:plane:"), desc, surface, 0);
+}
+
+static void
+release_target(struct target *t)
+{
+   if (t->image)
+      t->vk->DestroyImage(t->device, t->image, NULL);
+   if (t->memory)
+      t->vk->FreeMemory(t->device, t->memory, NULL);
+   if (t->texture)
+      ((void (*)(void *, SEL))objc_msgSend)(t->texture, sel_registerName("release"));
+   memset(t, 0, sizeof(*t));
+}
+
+/* The VkImage over `surface`'s texture. Mutex held. */
+static struct target *
+target_for(struct vkr_device *dev, IOSurfaceRef surface, VkFormat format, uint32_t width,
+           uint32_t height)
+{
+   VkDevice device = dev->base.handle.device;
+   struct vn_device_proc_table *vk = &dev->proc_table;
+   IOSurfaceID id = IOSurfaceGetID(surface);
+   struct target *free_slot = NULL, *oldest = NULL;
+   for (int i = 0; i < MAX_TARGETS; i++) {
+      struct target *t = &direct.targets[i];
+      if (t->used && t->device == device && t->surface_id == id && t->format == format &&
+          t->width == width && t->height == height) {
+         t->last_use = ++direct.uses;
+         return t;
+      }
+      if (!t->used && !free_slot)
+         free_slot = t;
+      if (t->used && !t->in_flight && (!oldest || t->last_use < oldest->last_use))
+         oldest = t;
+   }
+   if (!free_slot) {
+      if (!oldest)
+         return NULL;
+      release_target(oldest);
+      free_slot = oldest;
+   }
+   struct target *t = free_slot;
+   t->device = device;
+   t->vk = vk;
+   t->surface_id = id;
+   t->format = format;
+   t->width = width;
+   t->height = height;
+   t->texture = new_texture(surface, format, width, height);
+   if (!t->texture)
+      goto fail;
+
+   const VkExternalMemoryImageCreateInfo external = {
+      .sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO,
+      .handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_MTLTEXTURE_BIT_EXT,
+   };
+   const VkImageCreateInfo image_info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+      .pNext = &external,
+      .imageType = VK_IMAGE_TYPE_2D,
+      .format = format,
+      .extent = { width, height, 1 },
+      .mipLevels = 1,
+      .arrayLayers = 1,
+      .samples = VK_SAMPLE_COUNT_1_BIT,
+      .tiling = VK_IMAGE_TILING_OPTIMAL,
+      .usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+      .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+   };
+   if (vk->CreateImage(device, &image_info, NULL, &t->image) != VK_SUCCESS)
+      goto fail;
+   VkMemoryRequirements req;
+   vk->GetImageMemoryRequirements(device, t->image, &req);
+   const VkMemoryDedicatedAllocateInfo dedicated = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+      .image = t->image,
+   };
+   const VkImportMemoryMetalHandleInfoEXT import = {
+      .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_METAL_HANDLE_INFO_EXT,
+      .pNext = &dedicated,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_MTLTEXTURE_BIT_EXT,
+      .handle = t->texture,
+   };
+   const VkMemoryAllocateInfo alloc = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .pNext = &import,
+      .allocationSize = req.size,
+      .memoryTypeIndex = req.memoryTypeBits ? (uint32_t)__builtin_ctz(req.memoryTypeBits) : 0,
+   };
+   if (vk->AllocateMemory(device, &alloc, NULL, &t->memory) != VK_SUCCESS)
+      goto fail;
+   if (vk->BindImageMemory(device, t->image, t->memory, 0) != VK_SUCCESS)
+      goto fail;
+   t->used = true;
+   t->last_use = ++direct.uses;
+   return t;
+
+fail:
+   if (trace())
+      vkr_log("direct: no image over surface %u", id);
+   release_target(t);
+   return NULL;
+}
+
+static struct queue_state *
+queue_state_for(struct vkr_queue *queue)
+{
+   VkQueue q = queue->base.handle.queue;
+   struct queue_state *free_slot = NULL;
+   for (unsigned i = 0; i < ARRAY_SIZE(direct.queues); i++) {
+      if (direct.queues[i].used && direct.queues[i].queue == q)
+         return &direct.queues[i];
+      if (!direct.queues[i].used && !free_slot)
+         free_slot = &direct.queues[i];
+   }
+   if (!free_slot)
+      return NULL;
+   VkDevice device = queue->device->base.handle.device;
+   struct vn_device_proc_table *vk = &queue->device->proc_table;
+   const VkCommandPoolCreateInfo pool_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+      .flags = VK_COMMAND_POOL_CREATE_TRANSIENT_BIT,
+      .queueFamilyIndex = queue->family,
+   };
+   const VkSemaphoreCreateInfo sem_info = { .sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO };
+   if (vk->CreateCommandPool(device, &pool_info, NULL, &free_slot->pool) != VK_SUCCESS)
+      return NULL;
+   if (vk->CreateSemaphore(device, &sem_info, NULL, &free_slot->semaphore) != VK_SUCCESS) {
+      vk->DestroyCommandPool(device, free_slot->pool, NULL);
+      return NULL;
+   }
+   free_slot->queue = q;
+   free_slot->used = true;
+   return free_slot;
+}
+
+static void
+barrier(struct vn_device_proc_table *vk,
+        VkCommandBuffer cmd,
+        VkImage image,
+        VkImageLayout from,
+        VkImageLayout to,
+        VkAccessFlags src_access,
+        VkAccessFlags dst_access)
+{
+   const VkImageMemoryBarrier b = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+      .srcAccessMask = src_access,
+      .dstAccessMask = dst_access,
+      .oldLayout = from,
+      .newLayout = to,
+      .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .image = image,
+      .subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 },
+   };
+   vk->CmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                          VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, NULL, 0, NULL, 1, &b);
+}
+
+bool
+vkr_direct_submit(struct vkr_queue *queue,
+                  uint32_t submit_count,
+                  const struct vkr_direct_copy *copies,
+                  const VkSubmitInfo2 *waits,
+                  VkSemaphore *signal_out)
+{
+   VkDevice device = queue->device->base.handle.device;
+   struct vn_device_proc_table *vk = &queue->device->proc_table;
+   bool submitted = false;
+
+   pthread_mutex_lock(&direct.mutex);
+   for (uint32_t i = 0; i < submit_count && !submitted; i++) {
+      const struct vkr_direct_copy *c = &copies[i];
+      if (!c->valid)
+         continue;
+      struct offer *o = offer_for(c);
+      struct queue_state *qs = queue_state_for(queue);
+      if (!o || !qs)
+         continue;
+      struct target *t = target_for(queue->device, o->surface, c->format, c->width, c->height);
+      if (!t)
+         continue;
+
+      struct pending *p = calloc(1, sizeof(*p));
+      if (!p)
+         continue;
+      p->device = device;
+      p->vk = vk;
+      p->pool = qs->pool;
+      p->offer_id = o->id;
+      p->target = t;
+      const VkFenceCreateInfo fence_info = { .sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO };
+      if (vk->CreateFence(device, &fence_info, NULL, &p->fence) != VK_SUCCESS) {
+         free(p);
+         continue;
+      }
+      const VkCommandBufferAllocateInfo cmd_info = {
+         .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+         .commandPool = qs->pool,
+         .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+         .commandBufferCount = 1,
+      };
+      pthread_mutex_lock(&direct.pool_mutex);
+      VkResult r = vk->AllocateCommandBuffers(device, &cmd_info, &p->cmd);
+      if (r == VK_SUCCESS) {
+         const VkCommandBufferBeginInfo begin = {
+            .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+            .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
+         };
+         vk->BeginCommandBuffer(p->cmd, &begin);
+         /* As WSI's blit: the source from PRESENT_SRC and back. */
+         barrier(vk, p->cmd, c->src, VK_IMAGE_LAYOUT_PRESENT_SRC_KHR,
+                 VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_ACCESS_MEMORY_WRITE_BIT,
+                 VK_ACCESS_TRANSFER_READ_BIT);
+         barrier(vk, p->cmd, t->image, VK_IMAGE_LAYOUT_UNDEFINED,
+                 VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 0, VK_ACCESS_TRANSFER_WRITE_BIT);
+         const VkImageCopy region = {
+            .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+            .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+            .extent = { c->width, c->height, 1 },
+         };
+         vk->CmdCopyImage(p->cmd, c->src, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, t->image,
+                          VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+         barrier(vk, p->cmd, c->src, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                 VK_IMAGE_LAYOUT_PRESENT_SRC_KHR, VK_ACCESS_TRANSFER_READ_BIT,
+                 VK_ACCESS_MEMORY_READ_BIT);
+         r = vk->EndCommandBuffer(p->cmd);
+      }
+      pthread_mutex_unlock(&direct.pool_mutex);
+      if (r != VK_SUCCESS) {
+         vk->DestroyFence(device, p->fence, NULL);
+         free(p);
+         continue;
+      }
+
+      /* Its waits (the submit's), then the blit's submit waits for it. */
+      const VkSemaphoreSubmitInfo *w = waits[i].pWaitSemaphoreInfos;
+      uint32_t wait_count = waits[i].waitSemaphoreInfoCount;
+      VkSemaphore *sems = calloc(wait_count + 1, sizeof(*sems));
+      VkPipelineStageFlags *stages = calloc(wait_count + 1, sizeof(*stages));
+      uint64_t *values = calloc(wait_count + 1, sizeof(*values));
+      bool timeline = false;
+      for (uint32_t k = 0; k < wait_count; k++) {
+         sems[k] = w[k].semaphore;
+         stages[k] = VK_PIPELINE_STAGE_ALL_COMMANDS_BIT;
+         values[k] = w[k].value;
+         timeline |= w[k].value != 0;
+      }
+      uint64_t signal_value = 0;
+      const VkTimelineSemaphoreSubmitInfo timeline_info = {
+         .sType = VK_STRUCTURE_TYPE_TIMELINE_SEMAPHORE_SUBMIT_INFO,
+         .waitSemaphoreValueCount = wait_count,
+         .pWaitSemaphoreValues = values,
+         .signalSemaphoreValueCount = 1,
+         .pSignalSemaphoreValues = &signal_value,
+      };
+      const VkSubmitInfo submit = {
+         .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+         .pNext = timeline ? &timeline_info : NULL,
+         .waitSemaphoreCount = wait_count,
+         .pWaitSemaphores = sems,
+         .pWaitDstStageMask = stages,
+         .commandBufferCount = 1,
+         .pCommandBuffers = &p->cmd,
+         .signalSemaphoreCount = 1,
+         .pSignalSemaphores = &qs->semaphore,
+      };
+
+      o->claimed = true;
+      send_id(MSG_CLAIM, o->id, c->key);
+      r = vk->QueueSubmit(queue->base.handle.queue, 1, &submit, p->fence);
+      free(sems);
+      free(stages);
+      free(values);
+      if (r != VK_SUCCESS) {
+         /* (Claimed, not done: the shell gives the drawable up at the
+          * frame's fence.) */
+         send_id(MSG_REVOKED, o->id, NULL);
+         drop_offer(o);
+         pthread_mutex_lock(&direct.pool_mutex);
+         vk->FreeCommandBuffers(device, qs->pool, 1, &p->cmd);
+         pthread_mutex_unlock(&direct.pool_mutex);
+         vk->DestroyFence(device, p->fence, NULL);
+         free(p);
+         continue;
+      }
+      if (trace())
+         vkr_log("direct: frame of %s into offer %" PRIu64, c->key + 1, o->id);
+      t->in_flight++;
+      drop_offer(o);
+      list_addtail(&p->head, &direct.pending);
+      pthread_cond_signal(&direct.cond);
+      signal_out[i] = qs->semaphore;
+      submitted = true;
+   }
+   pthread_mutex_unlock(&direct.mutex);
+   return submitted;
+}
