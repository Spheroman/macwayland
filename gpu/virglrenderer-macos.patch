diff --git a/src/proxy/proxy_context.c b/src/proxy/proxy_context.c
index 4f87d5ac..06b1cf05 100644
--- a/src/proxy/proxy_context.c
+++ b/src/proxy/proxy_context.c
@@ -3,6 +3,19 @@
  * SPDX-License-Identifier: MIT
  */
 
+#ifdef __APPLE__
+/* (First, and its BSD list macros gone: util/list.h has its own.) */
+#include <sys/event.h>
+#undef LIST_ENTRY
+#undef LIST_HEAD
+#undef LIST_INIT
+#undef LIST_FIRST
+#undef LIST_NEXT
+#undef LIST_EMPTY
+#undef LIST_FOREACH
+#undef LIST_INSERT_HEAD
+#undef LIST_REMOVE
+#endif
 #include "proxy_context.h"
 
 #include <fcntl.h>
@@ -114,12 +127,21 @@ proxy_context_retire_timeline_fences_locked(struct proxy_context *ctx,
     */
    if (timeline->cur_seqno == cur_seqno && !list_is_empty(&timeline->fences)) {
       timeline->cur_seqno_stall_count++;
-      if (timeline->cur_seqno_stall_count < 100 ||
-          proxy_socket_is_connected(&ctx->socket))
+      if (!atomic_load(&ctx->sync_thread.hung_up) &&
+          (timeline->cur_seqno_stall_count < 100 ||
+           proxy_socket_is_connected(&ctx->socket)))
          return false;
 
       /* socket has been disconnected */
       force_retire_all = true;
+      /* Tell the client first that the context is lost (its worker died):
+       * a fence id of UINT64_MAX, which no client submits, before the
+       * fences are retired, so they can be failed rather than signaled.
+       */
+      if (!timeline->lost_reported) {
+         timeline->lost_reported = true;
+         ctx->base.fence_retire(&ctx->base, ring_idx, UINT64_MAX);
+      }
    }
 
    timeline->cur_seqno = cur_seqno;
@@ -175,6 +197,24 @@ proxy_context_sync_thread(void *arg)
          .fd = ctx->socket.fd,
       },
    };
+#ifdef __APPLE__
+   /* macOS's poll() doesn't report a stream socket's peer going (POLLHUP)
+    * when no events are asked for, and POLLIN would wake for every reply.
+    * A kqueue watching the socket for reading with a low-water mark no
+    * reply reaches says only when it ends (EV_EOF). */
+   int kq = kqueue();
+   if (kq >= 0) {
+      struct kevent ev;
+      EV_SET(&ev, ctx->socket.fd, EVFILT_READ, EV_ADD, NOTE_LOWAT, INT32_MAX, NULL);
+      if (kevent(kq, &ev, 1, NULL, 0, NULL) == 0) {
+         poll_fds[1].fd = kq;
+         poll_fds[1].events = POLLIN;
+      } else {
+         close(kq);
+         kq = -1;
+      }
+   }
+#endif
 
    assert(proxy_renderer.flags & VIRGL_RENDERER_ASYNC_FENCE_CB);
 
@@ -188,9 +228,38 @@ proxy_context_sync_thread(void *arg)
          break;
       }
 
+      /* A hung-up socket stays readable: stop watching it once it has gone,
+       * or this thread spins until the context is destroyed. */
+      bool hung_up = poll_fds[1].revents & (POLLHUP | POLLERR | POLLNVAL);
+#ifdef __APPLE__
+      if (kq >= 0 && poll_fds[1].fd == kq && (poll_fds[1].revents & POLLIN)) {
+         struct kevent ev;
+         const struct timespec zero = { 0, 0 };
+         hung_up = kevent(kq, NULL, 0, &ev, 1, &zero) == 1 && (ev.flags & EV_EOF);
+      }
+#endif
+      if (hung_up) {
+         atomic_store(&ctx->sync_thread.hung_up, true);
+         poll_fds[1].fd = -1;
+         /* The context is lost whether or not fences are pending: say so
+          * (a fence id of UINT64_MAX, see below). */
+         if (proxy_renderer.flags & VIRGL_RENDERER_ASYNC_FENCE_CB)
+            mtx_lock(&ctx->timeline_mutex);
+         if (!ctx->timelines[0].lost_reported) {
+            ctx->timelines[0].lost_reported = true;
+            ctx->base.fence_retire(&ctx->base, 0, UINT64_MAX);
+         }
+         if (proxy_renderer.flags & VIRGL_RENDERER_ASYNC_FENCE_CB)
+            mtx_unlock(&ctx->timeline_mutex);
+      }
+
       proxy_context_retire_fences_internal(ctx);
    }
 
+#ifdef __APPLE__
+   if (kq >= 0)
+      close(kq);
+#endif
    return 0;
 }
 
