+   /* With host memory import, a dma-buf here is host shm imported as host
+    * memory (vkr_dispatch_vkAllocateMemory): say so to the driver, which
+    * knows nothing of dma-bufs. */
+   struct vkr_device *dev = vkr_device_from_handle(args->device);
+   if (dev && dev->physical_device->use_host_memory_import) {
+      VkExternalMemoryBufferCreateInfo *ext = vkr_find_struct(
+         args->pCreateInfo->pNext, VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO);
