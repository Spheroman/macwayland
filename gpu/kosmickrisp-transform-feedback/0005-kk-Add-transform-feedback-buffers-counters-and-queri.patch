+/* Only occlusion queries remap their index, into the device's heap */
+static inline uint32_t
+kk_query_report_index(struct kk_query_pool *pool, uint32_t query)
+{
+   return kk_pool_is_oq(pool) ? kk_pool_index_ptr(pool)[query] : query;
+}
+
 static uint64_t
 kk_query_report_addr(struct kk_device *dev, struct kk_query_pool *pool,
                      uint32_t query)
@@ -76,9 +86,8 @@ kk_query_report_addr(struct kk_device *dev, struct kk_query_pool *pool,
    struct kk_bo *bo =
       kk_pool_is_oq(pool) ? dev->occlusion_queries.bo : pool->bo;
 
-   uint32_t index =
-      kk_pool_is_ts(pool) ? query : kk_pool_index_ptr(pool)[query];
-   return bo->gpu + pool->query_start + (index * sizeof(uint64_t));
+   uint32_t index = kk_query_report_index(pool, query);
+   return bo->gpu + pool->query_start + (index * pool->query_stride);
 }
 
 static uint64_t
@@ -95,11 +104,10 @@ kk_query_report_map(struct kk_device *dev, struct kk_query_pool *pool,
    struct kk_bo *bo =
       kk_pool_is_oq(pool) ? dev->occlusion_queries.bo : pool->bo;
 
-   uint64_t *queries = (uint64_t *)(bo->cpu + pool->query_start);
-   uint32_t index =
-      kk_pool_is_ts(pool) ? query : kk_pool_index_ptr(pool)[query];
+   uint32_t index = kk_query_report_index(pool, query);
 
-   return (struct kk_query_report *)&queries[index];
+   return (struct kk_query_report *)(bo->cpu + pool->query_start +
+                                     index * pool->query_stride);
 }
 
