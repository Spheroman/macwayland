diff --git a/src/kosmickrisp/libkk/kk_query.cl b/src/kosmickrisp/libkk/kk_query.cl
index 3c2e5f056ec..21b2b6d056e 100644
--- a/src/kosmickrisp/libkk/kk_query.cl
+++ b/src/kosmickrisp/libkk/kk_query.cl
@@ -94,3 +94,11 @@ libkk_copy_queries(global uint32_t *availability, global uint64_t *results,
       vk_write_query(dst, reports_per_query, flags, available);
    }
 }
+
+KERNEL(4)
+libkk_copy_xfb_counters(constant struct libkk_xfb_counter_copy *push)
+{
+   unsigned i = cl_local_id.x;
+
+   *(push->dest[i]) = push->src[i] ? *(push->src[i]) : 0;
+}
diff --git a/src/kosmickrisp/libkk/kk_query.h b/src/kosmickrisp/libkk/kk_query.h
index 56887401c5b..039d4645a1f 100644
--- a/src/kosmickrisp/libkk/kk_query.h
+++ b/src/kosmickrisp/libkk/kk_query.h
@@ -16,6 +16,12 @@ struct libkk_imm_write {
    uint32_t value;
 };
 
+/* Transform feedback counters: dest[i] = src[i] ? *src[i] : 0 */
+struct libkk_xfb_counter_copy {
+   DEVICE(uint32_t) dest[4];
+   DEVICE(uint32_t) src[4];
+};
+
 #define LIBKK_QUERY_UNAVAILABLE (uint64_t)((int64_t)-1)
 
 #endif /* KK_QUERY_H */
diff --git a/src/kosmickrisp/vulkan/kk_cmd_buffer.h b/src/kosmickrisp/vulkan/kk_cmd_buffer.h
index 31e82ca3140..5cbfd82c638 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_buffer.h
+++ b/src/kosmickrisp/vulkan/kk_cmd_buffer.h
@@ -201,6 +201,18 @@ struct kk_graphics_state {
       uint32_t instance_count;
    } gs;
 
+   /* Transform feedback, which a GS captures */
+   struct {
+      struct kk_addr_range buffers[KK_MAX_XFB_BUFFERS];
+      /* Byte offsets into each buffer, a pool allocation of 4 uint32_t
+       * reserved at the first vkCmdBeginTransformFeedbackEXT */
+      uint64_t offsets;
+      bool active;
+      /* Report of the active VK_QUERY_TYPE_TRANSFORM_FEEDBACK_STREAM_EXT
+       * query of each stream, or 0 */
+      uint64_t query[KK_MAX_XFB_STREAMS];
+   } xfb;
+
    /* Needed by vk_command_buffer::dynamic_graphics_state */
    struct vk_vertex_input_state _dynamic_vi;
    struct vk_sample_locations_state _dynamic_sl;
@@ -428,6 +440,19 @@ kk_grid_is_indirect(struct kk_grid grid)
    return grid.mode != KK_GRID_DIRECT;
 }
 
+/* Transform feedback or one of its queries is active, so a GS that captures
+ * it must run its transform feedback program */
+static inline bool
+kk_xfb_in_use(const struct kk_cmd_buffer *cmd)
+{
+   const struct kk_graphics_state *gfx = &cmd->state.gfx;
+   bool query = false;
+   for (uint32_t i = 0; i < KK_MAX_XFB_STREAMS; i++)
+      query |= gfx->xfb.query[i] != 0;
+
+   return gfx->xfb.active || query;
+}
+
 void kk_dispatch_precomp(struct kk_cmd_buffer *cmd, struct kk_grid grid,
                          bool pre_gfx, enum libkk_program idx, void *data,
                          size_t data_size);
diff --git a/src/kosmickrisp/vulkan/kk_cmd_draw.c b/src/kosmickrisp/vulkan/kk_cmd_draw.c
index 65956a619f6..4402f58def7 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_draw.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_draw.c
@@ -1277,24 +1277,37 @@ kk_gs_in_prim(struct kk_cmd_buffer *cmd)
       cmd->vk.dynamic_graphics_state.ia.primitive_topology);
 }
 
-/* Transform feedback writes no output and its counters go to scratch, so
- * nothing fits in the buffers */
+/* Transform feedback writes the bound buffers while active. Otherwise its
+ * offsets read zeroes, so nothing fits, and its counters go to scratch. */
 static void
 kk_set_xfb_params(struct kk_cmd_buffer *cmd, struct poly_geometry_params *p)
 {
    struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
    uint64_t zeroes = dev->xfb_scratch->gpu;
    uint64_t scratch = zeroes + KK_XFB_ZERO_SIZE;
 
-   for (uint32_t i = 0; i < POLY_MAX_SO_BUFFERS; ++i) {
-      p->xfb_base_original[i] = zeroes;
-      p->xfb_size[i] = 0u;
-      p->xfb_offs_ptrs[i] = zeroes;
+   static_assert(KK_MAX_XFB_BUFFERS == POLY_MAX_SO_BUFFERS, "poly's limit");
+   static_assert(KK_MAX_XFB_STREAMS == POLY_MAX_VERTEX_STREAMS, "poly's limit");
+
+   for (uint32_t i = 0; i < KK_MAX_XFB_BUFFERS; ++i) {
+      if (gfx->xfb.active) {
+         p->xfb_base_original[i] = gfx->xfb.buffers[i].addr;
+         p->xfb_size[i] = gfx->xfb.buffers[i].range;
+         p->xfb_offs_ptrs[i] = gfx->xfb.offsets + i * sizeof(uint32_t);
+      } else {
+         p->xfb_base_original[i] = zeroes;
+         p->xfb_size[i] = 0u;
+         p->xfb_offs_ptrs[i] = zeroes;
+      }
    }
 
-   for (uint32_t i = 0; i < POLY_MAX_VERTEX_STREAMS; ++i) {
-      p->xfb_prims_generated_counter[i] = scratch;
-      p->prims_generated_counter[i] = scratch;
+   /* A VK_QUERY_TYPE_TRANSFORM_FEEDBACK_STREAM_EXT query counts primitives
+    * written then primitives needed */
+   for (uint32_t i = 0; i < KK_MAX_XFB_STREAMS; ++i) {
+      uint64_t q = gfx->xfb.query[i];
+      p->xfb_prims_generated_counter[i] = q ? q : scratch;
+      p->prims_generated_counter[i] = q ? q + sizeof(uint64_t) : scratch;
       p->xfb_overflow[i] = scratch;
    }
    p->xfb_any_overflow = scratch;
@@ -2240,12 +2253,13 @@ kk_draw_without_restart(struct kk_cmd_buffer *cmd,
    return draw;
 }
 
-/* Whether the GS's transform feedback and query program runs. Until there is
- * transform feedback state, a GS capturing it always does, to scratch. */
+/* Whether the GS's transform feedback and query program runs: only while
+ * transform feedback or one of its queries is active. Otherwise the GS
+ * captures nothing, its rasterization VS finding no room in the buffers. */
 static bool
 kk_gs_captures(struct kk_cmd_buffer *cmd, const struct kk_shader *gs)
 {
-   return gs->info.gs.xfb;
+   return gs->info.gs.xfb && kk_xfb_in_use(cmd);
 }
 
 /* Runs the stage feeding the GS and the GS compute pass, returning the draw
@@ -2782,3 +2796,101 @@ kk_CmdDrawIndexedIndirectCount2KHR(VkCommandBuffer commandBuffer,
 
    kk_draw(cmd, &data);
 }
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdBindTransformFeedbackBuffersEXT(VkCommandBuffer commandBuffer,
+                                      uint32_t firstBinding,
+                                      uint32_t bindingCount,
+                                      const VkBuffer *pBuffers,
+                                      const VkDeviceSize *pOffsets,
+                                      const VkDeviceSize *pSizes)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+
+   for (uint32_t i = 0; i < bindingCount; i++) {
+      VK_FROM_HANDLE(kk_buffer, buffer, pBuffers[i]);
+      uint64_t size = pSizes ? pSizes[i] : VK_WHOLE_SIZE;
+
+      gfx->xfb.buffers[firstBinding + i] =
+         kk_buffer_addr_range(buffer, pOffsets[i], size);
+   }
+}
+
+/* Begin loads the offsets in bytes into each buffer from the counter buffers
+ * given, zero otherwise; end stores them to the counter buffers given */
+static void
+kk_begin_end_xfb(struct kk_cmd_buffer *cmd, uint32_t firstCounterBuffer,
+                 uint32_t counterBufferCount, const VkBuffer *pCounterBuffers,
+                 const VkDeviceSize *pCounterBufferOffsets, bool begin)
+{
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+
+   gfx->xfb.active = begin;
+
+   if (!gfx->xfb.offsets) {
+      gfx->xfb.offsets =
+         kk_pool_alloc(cmd, KK_MAX_XFB_BUFFERS * sizeof(uint32_t), 4).gpu;
+      if (!gfx->xfb.offsets)
+         return;
+   }
+
+   struct libkk_xfb_counter_copy params = {};
+   uint32_t copies = 0;
+
+   if (begin) {
+      for (copies = 0; copies < KK_MAX_XFB_BUFFERS; ++copies)
+         params.dest[copies] = gfx->xfb.offsets + copies * sizeof(uint32_t);
+   }
+
+   if (pCounterBuffers == NULL)
+      counterBufferCount = 0;
+
+   for (uint32_t i = 0; i < counterBufferCount; ++i) {
+      if (pCounterBuffers[i] == VK_NULL_HANDLE)
+         continue;
+
+      VK_FROM_HANDLE(kk_buffer, buffer, pCounterBuffers[i]);
+      uint64_t offset = pCounterBufferOffsets ? pCounterBufferOffsets[i] : 0;
+      uint64_t addr = vk_buffer_address(&buffer->vk, offset);
+      uint32_t idx = firstCounterBuffer + i;
+
+      if (begin) {
+         params.src[idx] = addr;
+      } else {
+         params.dest[copies] = addr;
+         params.src[copies] = gfx->xfb.offsets + idx * sizeof(uint32_t);
+         ++copies;
+      }
+   }
+
+   if (copies > 0) {
+      uint64_t push = kk_pool_upload(cmd, &params, sizeof(params), 8).gpu;
+      if (push)
+         libkk_copy_xfb_counters(cmd, kk_grid_1d(copies), true, push);
+   }
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdBeginTransformFeedbackEXT(VkCommandBuffer commandBuffer,
+                                uint32_t firstCounterBuffer,
+                                uint32_t counterBufferCount,
+                                const VkBuffer *pCounterBuffers,
+                                const VkDeviceSize *pCounterBufferOffsets)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   kk_begin_end_xfb(cmd, firstCounterBuffer, counterBufferCount,
+                    pCounterBuffers, pCounterBufferOffsets, true);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdEndTransformFeedbackEXT(VkCommandBuffer commandBuffer,
+                              uint32_t firstCounterBuffer,
+                              uint32_t counterBufferCount,
+                              const VkBuffer *pCounterBuffers,
+                              const VkDeviceSize *pCounterBufferOffsets)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   kk_begin_end_xfb(cmd, firstCounterBuffer, counterBufferCount,
+                    pCounterBuffers, pCounterBufferOffsets, false);
+}
