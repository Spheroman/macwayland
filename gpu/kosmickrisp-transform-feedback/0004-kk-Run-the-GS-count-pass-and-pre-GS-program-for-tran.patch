+      return lower_sysval_to_per_draw(b, intrin, scratch_addr);
+   case nir_intrinsic_ro_to_rw_poly:
+      b->cursor = nir_instr_remove(&intrin->instr);
+      nir_def_rewrite_uses(&intrin->def, intrin->src[0].ssa);
+      return true;
    case nir_intrinsic_load_index_size_poly:
       return lower_sysval_to_per_draw(b, intrin, index_size);
    case nir_intrinsic_load_first_vertex:
diff --git a/src/kosmickrisp/vulkan/kk_shader.c b/src/kosmickrisp/vulkan/kk_shader.c
index 23343420006..eca5a6d9106 100644
