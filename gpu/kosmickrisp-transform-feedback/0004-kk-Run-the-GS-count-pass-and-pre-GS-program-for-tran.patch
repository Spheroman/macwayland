@@ -857,6 +857,13 @@ kk_shader_destroy(struct vk_device *vk_dev, struct kk_shader *shader,
       pipe->gfx.render = NULL;
       pipe->gfx.ds_handle = NULL;
 
+      if (pipe->gfx.gs_count)
+         mtl_release(pipe->gfx.gs_count);
+      if (pipe->gfx.pre_gs)
+         mtl_release(pipe->gfx.pre_gs);
+      pipe->gfx.gs_count = NULL;
+      pipe->gfx.pre_gs = NULL;
+
       for (uint32_t i = 0u; i < pipe->gfx.pre_render_count; ++i)
          mtl_release(pipe->gfx.pre_render[i]);
 
@@ -874,6 +881,10 @@ kk_shader_destroy(struct vk_device *vk_dev, struct kk_shader *shader,
 
    ralloc_free((void *)shader->gs_main.entrypoint_name);
    ralloc_free((void *)shader->gs_main.code);
+   ralloc_free((void *)shader->gs_count.entrypoint_name);
+   ralloc_free((void *)shader->gs_count.code);
+   ralloc_free((void *)shader->pre_gs.entrypoint_name);
+   ralloc_free((void *)shader->pre_gs.code);
 
    vk_shader_free(&dev->vk, pAllocator, &shader->vk);
 }
@@ -1155,9 +1166,24 @@ kk_compile_shader(struct kk_device *dev, nir_shader *nir,
                &shader->info.gs);
 
       /* Only transform feedback and pipeline statistics need these, and KK
-       * exposes neither */
-      ralloc_free(count);
-      ralloc_free(pre_gs);
+       * exposes no pipeline statistics */
+      if (shader->info.gs.xfb) {
+         /* Counts the GS output of each input primitive, when the GS's counts
+          * are not static, to place it in the buffers */
+         if (count) {
+            count->info.stage = MESA_SHADER_COMPUTE;
+            memset(&count->info.cs, 0, sizeof(count->info.cs));
+            count->xfb_info = NULL;
+            kk_compile_msl(pdev, count, state, &shader->gs_count, apply_wa19);
+         }
+
+         /* Advances the buffer offsets and counts queries before the GS */
+         msl_preprocess_nir(pre_gs);
+         kk_compile_msl(pdev, pre_gs, state, &shader->pre_gs, false);
+      } else {
+         ralloc_free(count);
+         ralloc_free(pre_gs);
+      }
 
       nir->info.stage = MESA_SHADER_COMPUTE;
       memset(&nir->info.cs, 0, sizeof(nir->info.cs));
@@ -1482,6 +1508,10 @@ gather_graphics_pipeline_create_info(
 
       if (s->info.stage == MESA_SHADER_GEOMETRY) {
          kk_msl_copy(&vs->gs_main, &s->gs_main);
+         if (s->gs_count.code)
+            kk_msl_copy(&vs->gs_count, &s->gs_count);
+         if (s->pre_gs.code)
+            kk_msl_copy(&vs->pre_gs, &s->pre_gs);
          gs = s;
       }
    }
@@ -1557,6 +1587,21 @@ kk_compile_graphics_pipeline(struct kk_device *device, struct kk_shader *vs)
          &pipe->gfx.pre_render[pipe->gfx.pre_render_count++]);
       if (result != VK_SUCCESS)
          return VK_ERROR_INVALID_SHADER_NV;
+
+      if (vs->gs_count.code) {
+         result = kk_compile_compute_pipeline(device, &vs->gs_count,
+                                              KK_POLY_WG_SIZE,
+                                              &pipe->gfx.gs_count);
+         if (result != VK_SUCCESS)
+            return VK_ERROR_INVALID_SHADER_NV;
+      }
+
+      if (vs->pre_gs.code) {
+         result = kk_compile_compute_pipeline(device, &vs->pre_gs, 1u,
+                                              &pipe->gfx.pre_gs);
+         if (result != VK_SUCCESS)
+            return VK_ERROR_INVALID_SHADER_NV;
+      }
    }
 
    const struct msl_compile_data *vs_data = &vs->msl_data[vs_stage];
@@ -1842,6 +1887,17 @@ kk_msl_serialize(const struct msl_compile_data *data, struct blob *blob)
    blob_write_bytes(blob, data->code, code_length);
 }
 
+/* For the GS count pass and pre-GS program, which only transform feedback
+ * needs */
+static void
+kk_msl_serialize_optional(const struct msl_compile_data *data,
+                          struct blob *blob)
+{
+   blob_write_uint8(blob, data->code != NULL);
+   if (data->code != NULL)
+      kk_msl_serialize(data, blob);
+}
+
 static bool
 kk_shader_serialize(struct vk_device *vk_dev, const struct vk_shader *vk_shader,
                     struct blob *blob)
@@ -1855,8 +1911,11 @@ kk_shader_serialize(struct vk_device *vk_dev, const struct vk_shader *vk_shader,
          kk_msl_serialize(&shader->msl_data[stage], blob);
       }
    }
-   if (kk_has_gs_main(&shader->info))
+   if (kk_has_gs_main(&shader->info)) {
       kk_msl_serialize(&shader->gs_main, blob);
+      kk_msl_serialize_optional(&shader->gs_count, blob);
+      kk_msl_serialize_optional(&shader->pre_gs, blob);
+   }
 
    return !blob->out_of_memory;
 }
@@ -1883,6 +1942,17 @@ kk_msl_deserialize(struct blob_reader *blob, struct msl_compile_data *data)
    return VK_SUCCESS;
 }
 
+static VkResult
+kk_msl_deserialize_optional(struct blob_reader *blob,
+                            struct msl_compile_data *data)
+{
+   if (!blob_read_uint8(blob))
+      return blob->overrun ? VK_ERROR_INCOMPATIBLE_SHADER_BINARY_EXT
+                           : VK_SUCCESS;
+
+   return kk_msl_deserialize(blob, data);
+}
+
 static VkResult
 kk_deserialize_shader(struct vk_device *vk_dev, struct blob_reader *blob,
                       uint32_t binary_version,
@@ -1917,6 +1987,10 @@ kk_deserialize_shader(struct vk_device *vk_dev, struct blob_reader *blob,
 
    if (kk_has_gs_main(&info)) {
       result = kk_msl_deserialize(blob, &shader->gs_main);
+      if (result == VK_SUCCESS)
+         result = kk_msl_deserialize_optional(blob, &shader->gs_count);
+      if (result == VK_SUCCESS)
+         result = kk_msl_deserialize_optional(blob, &shader->pre_gs);
       if (result != VK_SUCCESS)
          goto fail;
    }
