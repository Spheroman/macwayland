    NIR_PASS(_, nir, kk_nir_lower_vbo, attributes, robustness2);
 }
 
+/* In any situation where both clip and clamp can be disabled, the vertex
+ * stage on hardware emulates the viewport Z transform */
+static bool
+kk_emulates_viewport_z(const struct vk_graphics_pipeline_state *state)
+{
+   return state != NULL && kk_is_possible_both_depth_clip_clamp(state, false);
+}
