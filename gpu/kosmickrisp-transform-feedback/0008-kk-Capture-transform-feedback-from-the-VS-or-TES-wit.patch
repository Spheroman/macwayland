 }
 
+static bool
+gather_output_layout(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   struct poly_passthrough_gs_key *key = data;
+   if (intr->intrinsic != nir_intrinsic_store_output)
+      return false;
+
+   nir_io_semantics sem = nir_intrinsic_io_semantics(intr);
+   unsigned loc = sem.location;
+   if (nir_src_is_const(intr->src[1]))
+      loc += nir_src_as_uint(intr->src[1]);
+   if (loc >= NUM_TOTAL_VARYING_SLOTS)
+      return false;
+
+   unsigned component = nir_intrinsic_component(intr);
+   unsigned mask = nir_intrinsic_write_mask(intr) << component;
+   key->output_components[loc] =
+      MAX2(key->output_components[loc], util_last_bit(mask));
+   if (key->output_types[loc] == nir_type_invalid)
+      key->output_types[loc] = nir_intrinsic_src_type(intr);
+   if (sem.no_varying)
+      key->xfb_only_mask[loc] |= mask;
+   return false;
+}
+
+static void
+kk_xfb_passthrough_destroy(struct kk_device *dev,
+                           struct kk_xfb_passthrough *xfb,
+                           const VkAllocationCallbacks *pAllocator)
+{
+   if (xfb == NULL)
+      return;
+
+   if (xfb->feed)
+      kk_shader_destroy(&dev->vk, xfb->feed, pAllocator);
+   /* Built while recording, with the device's allocator */
+   if (xfb->vs)
+      kk_shader_destroy(&dev->vk, xfb->vs, NULL);
+   if (xfb->gs)
+      kk_shader_destroy(&dev->vk, xfb->gs, NULL);
+   simple_mtx_destroy(&xfb->lock);
+   free(xfb->key);
+   free(xfb);
+}
+
+static struct kk_xfb_passthrough *
+kk_xfb_passthrough_alloc(size_t key_size)
+{
+   struct kk_xfb_passthrough *xfb = calloc(1, sizeof(*xfb));
+   if (xfb == NULL)
+      return NULL;
+
+   xfb->key = calloc(1, key_size);
+   if (xfb->key == NULL) {
+      free(xfb);
+      return NULL;
+   }
+
+   xfb->key_size = key_size;
+   simple_mtx_init(&xfb->lock, mtx_plain);
+   return xfb;
+}
+
+/* Describes the passthrough GS for the VS or TES capturing transform
+ * feedback, linked to the FS with its IO lowered */
+static struct kk_xfb_passthrough *
+kk_xfb_passthrough_create(nir_shader *last, nir_shader *tcs,
+                          const struct vk_graphics_pipeline_state *state)
+{
+   const nir_xfb_info *xfb_info = last->xfb_info;
+   struct kk_xfb_passthrough *xfb =
+      kk_xfb_passthrough_alloc(poly_passthrough_gs_key_size(xfb_info->output_count));
+   if (xfb == NULL)
+      return NULL;
+
+   struct poly_passthrough_gs_key *key = xfb->key;
+
+   if (last->info.stage == MESA_SHADER_TESS_EVAL) {
+      bool points = last->info.tess.point_mode ||
+                    (tcs != NULL && tcs->info.tess.point_mode);
+      enum tess_primitive_mode mode = last->info.tess._primitive_mode;
+      if (mode == TESS_PRIMITIVE_UNSPECIFIED && tcs != NULL)
+         mode = tcs->info.tess._primitive_mode;
+
+      key->prim = points                           ? MESA_PRIM_POINTS
+                  : mode == TESS_PRIMITIVE_ISOLINES ? MESA_PRIM_LINES
+                                                    : MESA_PRIM_TRIANGLES;
+   } else {
+      /* The pipeline's topology gives the class, all a dynamic topology may
+       * change, and adjacency draws are unrolled to lists through it */
+      key->prim = u_reduced_prim(
+         vk_topology_to_mesa(state->ia->primitive_topology));
+   }
+
+   key->outputs = last->info.outputs_written;
+   key->clip_distance_array_size = last->info.clip_distance_array_size;
+   key->cull_distance_array_size = last->info.cull_distance_array_size;
+
+   nir_shader_intrinsics_pass(last, gather_output_layout, nir_metadata_all,
+                              key);
+   for (unsigned i = 0; i < NUM_TOTAL_VARYING_SLOTS; i++) {
+      if (key->output_components[i] == 0)
+         key->output_components[i] = 4;
+      if (key->output_types[i] == nir_type_invalid)
+         key->output_types[i] = nir_type_uint32;
+   }
+
+   typed_memcpy(key->xfb_stride, last->info.xfb_stride,
+                ARRAY_SIZE(key->xfb_stride));
+   memcpy(&key->xfb_info, xfb_info, nir_xfb_info_size(xfb_info->output_count));
+
+   xfb->emulate_viewport_z = kk_emulates_viewport_z(state);
+   return xfb;
+}
+
 static VkResult
 kk_compile_shaders(struct vk_device *device, uint32_t shader_count,
                    struct vk_shader_compile_info *infos,
@@ -1784,6 +1922,13 @@ kk_compile_shaders(struct vk_device *device, uint32_t shader_count,
    nir_shader *nir_shaders[shader_count + 1u];
    struct kk_shader *shaders[shader_count + 1u];
 
+   bool has_gs = false;
+   for (uint32_t i = 0u; i < shader_count; ++i)
+      has_gs |= infos[i].stage == MESA_SHADER_GEOMETRY;
+
+   /* Index of the VS or TES capturing transform feedback without a GS */
+   uint32_t xfb_index = UINT32_MAX;
+
    /* Lower shaders, notably lowering IO. This is a prerequisite for intershader
     * optimization. */
    const struct vk_pipeline_robustness_state *vertex_robustness = &rs_none;
@@ -1796,10 +1941,26 @@ kk_compile_shaders(struct vk_device *device, uint32_t shader_count,
          info->next_stage_mask & (VK_SHADER_STAGE_TESSELLATION_CONTROL_BIT |
                                   VK_SHADER_STAGE_GEOMETRY_BIT);
 
+      /* The last stage before rasterization capturing transform feedback is
+       * also compiled to feed a passthrough GS, so it is lowered for the
+       * hardware after linking */
+      if (state && !has_gs && !emulated_stage && nir->xfb_info != NULL &&
+          (nir->info.stage == MESA_SHADER_VERTEX ||
+           nir->info.stage == MESA_SHADER_TESS_EVAL)) {
+         emulated_stage = true;
+         xfb_index = i;
+      }
+
       msl_preprocess_nir_workarounds(nir, pdev->settings.disabled_workarounds);
       kk_lower_nir(dev, nir, emulated_stage, info->robustness,
                    info->set_layout_count, info->set_layouts, state, features);
 
+      /* Linking must keep the outputs transform feedback captures */
+      if (nir->xfb_info != NULL) {
+         NIR_PASS(_, nir, nir_opt_constant_folding);
+         NIR_PASS(_, nir, nir_io_add_intrinsic_xfb_info);
+      }
+
       if (nir->info.stage == MESA_SHADER_VERTEX)
          vertex_robustness = info->robustness;
 
@@ -1836,11 +1997,59 @@ kk_compile_shaders(struct vk_device *device, uint32_t shader_count,
    nir_opt_varyings_bulk(nir_shaders, total_shaders, true, UINT32_MAX,
                          UINT32_MAX, nir_opts, NULL);
 
+   /* The stage capturing transform feedback is linked to the FS. Describe the
+    * passthrough GS for it, compile a copy feeding that GS, and lower it for
+    * the hardware. */
+   struct kk_xfb_passthrough *xfb = NULL;
+   nir_shader *xfb_feed = NULL;
+   if (xfb_index != UINT32_MAX) {
+      nir_shader *last = nir_shaders[xfb_index];
+      nir_shader *tcs = xfb_index > 0 ? nir_shaders[xfb_index - 1u] : NULL;
+      if (tcs && tcs->info.stage != MESA_SHADER_TESS_CTRL)
+         tcs = NULL;
+
+      xfb = kk_xfb_passthrough_create(last, tcs, state);
+      if (xfb == NULL) {
+         for (uint32_t j = 0; j < total_shaders; j++)
+            ralloc_free(nir_shaders[j]);
+         memset(shaders_out, 0, shader_count * sizeof(*shaders_out));
+         return vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
+      }
+
+      xfb_feed = nir_shader_clone(NULL, last);
+      xfb_feed->info.next_stage = MESA_SHADER_GEOMETRY;
+
+      kk_lower_hw_vs(last, xfb->emulate_viewport_z,
+                     kk_hw_vs_is_point(last, state));
+      NIR_PASS(_, last, kk_nir_lower_descriptors, vertex_robustness, 0, NULL);
+   }
+
    for (uint32_t i = 0; i < total_shaders; i++) {
       struct kk_shader *prev_stage = i > 0 ? shaders[i - 1] : NULL;
-      result =
-         kk_compile_shader(dev, nir_shaders[i], prev_stage, vertex_robustness,
-                           state, pAllocator, &shaders[i], apply_wa19);
+
+      if (i == xfb_index) {
+         /* KK_WORKAROUND_19 applies to the stage feeding a GS */
+         bool feed_wa19 =
+            !(pdev->settings.disabled_workarounds & BITFIELD64_BIT(19));
+         result = kk_compile_shader(dev, xfb_feed, prev_stage,
+                                    vertex_robustness, state, false,
+                                    pAllocator, &xfb->feed, feed_wa19);
+         xfb_feed = NULL;
+         if (result != VK_SUCCESS) {
+            for (uint32_t j = 0; j < i; j++)
+               kk_shader_destroy(&dev->vk, shaders[j], pAllocator);
+            for (uint32_t j = i; j < total_shaders; j++)
+               ralloc_free(nir_shaders[j]);
+            kk_xfb_passthrough_destroy(dev, xfb, pAllocator);
+            memset(shaders_out, 0, shader_count * sizeof(*shaders_out));
+            return result;
+         }
+      }
+
+      result = kk_compile_shader(dev, nir_shaders[i], prev_stage,
+                                 vertex_robustness, state,
+                                 kk_emulates_viewport_z(state), pAllocator,
+                                 &shaders[i], apply_wa19);
 
       if (result != VK_SUCCESS) {
          /* Clean up all the shaders before this point */
@@ -1850,6 +2059,8 @@ kk_compile_shaders(struct vk_device *device, uint32_t shader_count,
          /* Clean up all the NIR after this point */
          for (uint32_t j = i + 1; j < total_shaders; j++)
             ralloc_free(nir_shaders[j]);
+         ralloc_free(xfb_feed);
+         kk_xfb_passthrough_destroy(dev, xfb, pAllocator);
 
