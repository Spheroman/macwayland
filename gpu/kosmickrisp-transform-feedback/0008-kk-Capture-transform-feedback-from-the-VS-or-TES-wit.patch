+/* The passthrough GS stores the second slot of clip and cull distances at an
+ * offset of 1 */
+static bool
+fold_output_offset(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   if (intr->intrinsic != nir_intrinsic_store_output ||
+       !nir_src_is_const(intr->src[1]) || nir_src_as_uint(intr->src[1]) == 0)
+      return false;
+
+   unsigned offset = nir_src_as_uint(intr->src[1]);
+   nir_io_semantics sem = nir_intrinsic_io_semantics(intr);
+   sem.location += offset;
+   sem.num_slots = MAX2(sem.num_slots, offset + 1) - offset;
+   nir_intrinsic_set_io_semantics(intr, sem);
+
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_src_rewrite(&intr->src[1], nir_imm_int(b, 0));
+   return true;
