+   vs->info = api_vs->info;
+   vs->info.vs.has_xfb_passthrough = false;
+   /* The VS feeding the GS writes no outputs the hardware VS adds */
+   if (feed == MESA_SHADER_VERTEX) {
+      vs->info.outputs_written = xfb->feed->info.outputs_written;
+      vs->info.uses_per_draw_data = xfb->feed->info.uses_per_draw_data;
+   }
