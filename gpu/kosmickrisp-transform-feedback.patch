+/* Components of each varying slot the FS reads */
+struct kk_fs_inputs {
+   uint8_t comps[NUM_TOTAL_VARYING_SLOTS];
+};
+
+static bool
+gather_fs_input(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   struct kk_fs_inputs *in = data;
+   if (intr->intrinsic != nir_intrinsic_load_input &&
+       intr->intrinsic != nir_intrinsic_load_interpolated_input)
+      return false;
+
+   nir_io_semantics sem = nir_intrinsic_io_semantics(intr);
+   nir_src *offset = nir_get_io_offset_src(intr);
+   unsigned first = sem.location, last = sem.location + sem.num_slots;
+   if (nir_src_is_const(*offset)) {
+      first += nir_src_as_uint(*offset);
+      last = first + 1;
+   }
+
+   unsigned comps = nir_intrinsic_component(intr) + intr->def.num_components;
+   for (unsigned loc = first; loc < MIN2(last, NUM_TOTAL_VARYING_SLOTS); loc++)
+      in->comps[loc] = MAX2(in->comps[loc], comps);
+   return false;
+}
+
+static bool
+trim_rast_output(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   const struct kk_fs_inputs *in = data;
+   if (intr->intrinsic != nir_intrinsic_store_output)
+      return false;
+
+   nir_io_semantics sem = nir_intrinsic_io_semantics(intr);
+   if (sem.location < VARYING_SLOT_VAR0 || !nir_src_is_const(intr->src[1]))
+      return false;
+
+   unsigned loc = sem.location + nir_src_as_uint(intr->src[1]);
+   unsigned comps = loc < NUM_TOTAL_VARYING_SLOTS ? in->comps[loc] : 0;
+   unsigned component = nir_intrinsic_component(intr);
+   nir_def *value = intr->src[0].ssa;
+   if (comps == 0 || component + value->num_components <= comps)
+      return false;
+
+   if (component >= comps) {
+      nir_instr_remove(&intr->instr);
+      return true;
+   }
+
+   b->cursor = nir_before_instr(&intr->instr);
+   unsigned keep = comps - component;
+   nir_src_rewrite(&intr->src[0], nir_trim_vector(b, value, keep));
+   intr->num_components = keep;
+   nir_intrinsic_set_write_mask(intr,
+                                nir_intrinsic_write_mask(intr) &
+                                   BITFIELD_MASK(keep));
+   return true;
+}
+
+/* Metal wants the rasterized vertex's outputs typed as the FS reads them.
+ * Linking trims them, but not those transform feedback captures, which a GS
+ * captures before rasterizing. */
+static void
+kk_trim_rast_outputs(nir_shader *rast, const struct kk_fs_inputs *fs_inputs)
+{
+   if (fs_inputs == NULL)
+      return;
+
+   nir_shader_intrinsics_pass(rast, trim_rast_output,
+                              nir_metadata_control_flow, (void *)fs_inputs);
+}
