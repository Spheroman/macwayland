+++ b/src/kosmickrisp/vulkan/kk_cmd_buffer.h
@@ -93,6 +93,13 @@ struct kk_per_draw_data {
 
    /* Whether the last vertex of a primitive is its provoking vertex */
    uint32_t provoking_last;
+
+   /* Vertex stream rasterized when a GS writes several */
+   uint32_t rasterization_stream;
+
+   /* Scratch the GS transform feedback and query program writes statistics
+    * KK does not expose to */
+   uint64_t scratch_addr;
 };
 
 struct kk_attachment {
@@ -192,8 +199,24 @@ struct kk_graphics_state {
       struct kk_addr_range index;
       uint32_t index_count;
       uint32_t instance_count;
+      /* Primitive the GS reads: the draw's after any unrolling, or the
+       * tessellator's */
+      enum mesa_prim in_prim;
    } gs;
 
+   /* Transform feedback, captured by the GS (or a passthrough GS standing in
+    * for one) */
+   struct {
+      struct kk_addr_range buffers[KK_MAX_XFB_BUFFERS];
+      /* Byte offsets into each buffer, a pool allocation of 4 uint32_t
+       * reserved at the first vkCmdBeginTransformFeedbackEXT */
+      uint64_t offsets;
+      bool active;
+      /* Report of the active VK_QUERY_TYPE_TRANSFORM_FEEDBACK_STREAM_EXT
+       * query of each stream, or 0 */
+      uint64_t query[KK_MAX_XFB_STREAMS];
+   } xfb;
+
    /* Needed by vk_command_buffer::dynamic_graphics_state */
    struct vk_vertex_input_state _dynamic_vi;
    struct vk_sample_locations_state _dynamic_sl;
diff --git a/src/kosmickrisp/vulkan/kk_cmd_draw.c b/src/kosmickrisp/vulkan/kk_cmd_draw.c
index 126f94bc100..8f65cbe6bb3 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_draw.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_draw.c
@@ -1267,14 +1267,11 @@ kk_upload_tess_params(struct kk_cmd_buffer *cmd, struct poly_tess_params *out,
    memcpy(out, &args, sizeof(args));
 }
 
+/* Set by kk_draw before the per-draw data is uploaded */
 static enum mesa_prim
 kk_gs_in_prim(struct kk_cmd_buffer *cmd)
 {
-   if (cmd->state.shaders[MESA_SHADER_TESS_EVAL])
-      return cmd->state.gfx.tess.prim;
-
-   return vk_topology_to_mesa(
-      cmd->vk.dynamic_graphics_state.ia.primitive_topology);
+   return cmd->state.gfx.gs.in_prim;
 }
 
 static uint64_t
@@ -1298,6 +1295,39 @@ kk_upload_geometry_params(struct kk_cmd_buffer *cmd,
    struct poly_geometry_params params;
    poly_geometry_params_init(&params, mode, wg_size);
 
+   /* Transform feedback writes the bound buffers while active. Otherwise its
+    * offsets read zeroes, so no output fits, and its counters go to
+    * scratch. */
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   uint64_t zeroes = dev->xfb_scratch->gpu;
+   uint64_t scratch = zeroes + KK_XFB_ZERO_SIZE;
+   for (uint32_t i = 0; i < KK_MAX_XFB_BUFFERS; ++i) {
+      if (gfx->xfb.active) {
+         params.xfb_base_original[i] = gfx->xfb.buffers[i].addr;
+         params.xfb_size[i] = gfx->xfb.buffers[i].range;
+         params.xfb_offs_ptrs[i] = gfx->xfb.offsets + i * sizeof(uint32_t);
+      } else {
+         params.xfb_base_original[i] = zeroes;
+         params.xfb_size[i] = 0u;
+         params.xfb_offs_ptrs[i] = zeroes;
+      }
+   }
+
+   /* A VK_QUERY_TYPE_TRANSFORM_FEEDBACK_STREAM_EXT query counts primitives
+    * written then primitives needed */
+   for (uint32_t i = 0; i < KK_MAX_XFB_STREAMS; ++i) {
+      uint64_t q = gfx->xfb.query[i];
+      params.xfb_prims_generated_counter[i] = q ? q : scratch;
+      params.prims_generated_counter[i] = q ? q + sizeof(uint64_t) : scratch;
+      params.xfb_overflow[i] = scratch;
+   }
+   params.xfb_any_overflow = scratch;
+
+   /* The GS count pass writes each input primitive's counts, prefix summed
+    * for transform feedback */
+   params.count_buffer_stride = gs->info.gs.count_words * sizeof(uint32_t);
+   bool prefix_sum = gs->info.gs.prefix_sum;
+
    if (indirect) {
       /* The indirect setup kernel writes the draw and allocates from the
        * heap, including the index buffer */
@@ -1307,6 +1337,11 @@ kk_upload_geometry_params(struct kk_cmd_buffer *cmd,
       poly_geometry_params_set_draw(&params, mode, shape, max_indices,
                                     draw->grid.size.x, draw->grid.size.y);
 
+      uint32_t count_size_B =
+         params.input_primitives * params.count_buffer_stride;
+      if (prefix_sum && count_size_B)
+         params.count_buffer = kk_pool_alloc(cmd, count_size_B, 4).gpu;
+
       gfx->gs.index_count = params.draw.index_count;
       gfx->gs.instance_count = params.draw.instance_count;
 
@@ -2060,6 +2095,9 @@ kk_upload_per_draw_data(struct kk_cmd_buffer *cmd, uint32_t upload_mask,
          &cmd->vk.dynamic_graphics_state;
       gfx->per_draw_data.provoking_last =
          dyn->rs.provoking_vertex == VK_PROVOKING_VERTEX_MODE_LAST_VERTEX_EXT;
+      gfx->per_draw_data.rasterization_stream = dyn->rs.rasterization_stream;
+      gfx->per_draw_data.scratch_addr =
+         kk_cmd_buffer_device(cmd)->xfb_scratch->gpu + KK_XFB_ZERO_SIZE;
    }
 
    struct kk_ptr shader_data_gpu =
@@ -2236,6 +2274,7 @@ kk_launch_gs_prerast(struct kk_cmd_buffer *cmd,
          .heap = kk_heap(cmd),
          .vs_outputs = (tes ? tes : vs)->info.outputs_written,
          .prim = mode,
+         .is_prefix_summing = gs->info.gs.prefix_sum,
          .max_indices = gs->info.gs.max_indices,
          .shape = shape,
       };
@@ -2277,6 +2316,31 @@ kk_launch_gs_prerast(struct kk_cmd_buffer *cmd,
       enc, vs->pipeline.gfx.pre_render[pre_render_count - 2u]);
    kk_dispatch_compute(enc, grid_vs, local_size);
 
+   /* Transform feedback places each primitive's output from the GS's counts
+    * and the buffers' offsets, which the pre-GS program advances past the
+    * draw's output, counting queries, before the GS runs. */
+   if (gs->info.gs.xfb) {
+      if (gs->info.gs.count_words) {
+         mtl_barrier_after_encoder_stages(enc, MTL_STAGE_DISPATCH,
+                                          MTL_STAGE_DISPATCH);
+         mtl_compute_set_pipeline_state(enc, vs->pipeline.gfx.gs_count);
+         kk_dispatch_compute(enc, grid_gs, local_size);
+      }
+
+      if (gs->info.gs.prefix_sum) {
+         libkk_prefix_sum_geom(
+            cmd, kk_grid_1d(1024u * gs->info.gs.count_words), true,
+            geometry_params);
+         enc = cs_get_compute(cmd);
+      }
+
+      mtl_barrier_after_encoder_stages(enc, MTL_STAGE_DISPATCH,
+                                       MTL_STAGE_DISPATCH);
+      mtl_compute_set_pipeline_state(enc, vs->pipeline.gfx.pre_gs);
+      mtl_dispatch_threads(enc, (struct mtl_size){1, 1, 1},
+                           (struct mtl_size){1, 1, 1});
+   }
+
    mtl_barrier_after_encoder_stages(enc, MTL_STAGE_DISPATCH,
                                     MTL_STAGE_DISPATCH);
    mtl_compute_set_pipeline_state(
@@ -2368,10 +2432,15 @@ kk_draw(struct kk_cmd_buffer *cmd, struct kk_draw_command *data)
    if (requires_unroll(cmd, data) && !kk_unroll_geometry(cmd, data))
       return;
 
-   if (!geom && mesa_prim_has_adjacency(data->prim) &&
-       !kk_unroll_adjacency(cmd, data))
+   /* A passthrough GS reads the topology its pipeline was built for, which
+    * has no adjacency */
+   struct kk_shader *gs = cmd->state.shaders[MESA_SHADER_GEOMETRY];
+   if ((!geom || gs->is_passthrough) && !tess &&
+       mesa_prim_has_adjacency(data->prim) && !kk_unroll_adjacency(cmd, data))
       return;
 
+   cmd->state.gfx.gs.in_prim = tess ? cmd->state.gfx.tess.prim : data->prim;
+
    /* Patch lists do not restart, so only a GS fed by the input assembly needs
     * its restarts unrolled. The unroll kernel reads an indirect draw. */
    bool gs_restart = geom && !tess && data->restart && data->indexed;
@@ -2710,3 +2779,144 @@ kk_CmdDrawIndexedIndirectCount2KHR(VkCommandBuffer commandBuffer,
 
    kk_draw(cmd, &data);
 }
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdDrawIndirectByteCountEXT(VkCommandBuffer commandBuffer,
+                               uint32_t instanceCount, uint32_t firstInstance,
+                               VkBuffer counterBuffer,
+                               VkDeviceSize counterBufferOffset,
+                               uint32_t counterOffset, uint32_t vertexStride)
+{
+   if (instanceCount == 0)
+      return;
+
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   VK_FROM_HANDLE(kk_buffer, counter, counterBuffer);
+
+   const struct vk_dynamic_graphics_state *dyn =
+      &cmd->vk.dynamic_graphics_state;
+
+   /* The GPU turns the byte count into an indirect draw */
+   struct kk_ptr draw = kk_pool_alloc(cmd, sizeof(VkDrawIndirectCommand), 4u);
+   if (unlikely(!draw.gpu))
+      return;
+
+   libkk_draw_from_byte_count(
+      cmd, kk_grid_1d(1), true, draw.gpu,
+      vk_buffer_address(&counter->vk, counterBufferOffset), counterOffset,
+      vertexStride, instanceCount, firstInstance);
+
+   struct kk_draw_command data = {
+      .prim = vk_topology_to_mesa(dyn->ia.primitive_topology),
+      .upload_mask = build_per_draw_upload_mask(cmd),
+      .indirect = true,
+      .predicate_count = cmd->state.cond_render.enabled ? 1u : 0u,
+      .predicate_op[0] = cmd->state.cond_render.inverted
+                            ? KK_PREDICATE_EQ_ZERO
+                            : KK_PREDICATE_NEQ_ZERO,
+      .draw_count = 1,
+      .predicate_addr[0] = cmd->state.cond_render.address,
+      .indirect_command.addr = draw.gpu,
+      .indirect_command.stride = sizeof(VkDrawIndirectCommand),
+   };
+
+   kk_draw(cmd, &data);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdBindTransformFeedbackBuffersEXT(VkCommandBuffer commandBuffer,
+                                      uint32_t firstBinding,
+                                      uint32_t bindingCount,
+                                      const VkBuffer *pBuffers,
+                                      const VkDeviceSize *pOffsets,
+                                      const VkDeviceSize *pSizes)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+
+   for (uint32_t i = 0; i < bindingCount; i++) {
+      VK_FROM_HANDLE(kk_buffer, buffer, pBuffers[i]);
+      uint64_t size = pSizes ? pSizes[i] : VK_WHOLE_SIZE;
+
+      gfx->xfb.buffers[firstBinding + i] =
+         kk_buffer_addr_range(buffer, pOffsets[i], size);
+   }
+}
+
+/* Begin loads the offsets in bytes into each buffer from the counter buffers
+ * given, zero otherwise; end stores them to the counter buffers given */
+static void
+kk_begin_end_xfb(struct kk_cmd_buffer *cmd, uint32_t firstCounterBuffer,
+                 uint32_t counterBufferCount, const VkBuffer *pCounterBuffers,
+                 const VkDeviceSize *pCounterBufferOffsets, bool begin)
+{
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+
+   gfx->xfb.active = begin;
+
+   if (!gfx->xfb.offsets) {
+      gfx->xfb.offsets =
+         kk_pool_alloc(cmd, KK_MAX_XFB_BUFFERS * sizeof(uint32_t), 4).gpu;
+      if (!gfx->xfb.offsets)
+         return;
+   }
+
+   struct libkk_xfb_counter_copy params = {};
+   uint32_t copies = 0;
+
+   if (begin) {
+      for (copies = 0; copies < KK_MAX_XFB_BUFFERS; ++copies)
+         params.dest[copies] = gfx->xfb.offsets + copies * sizeof(uint32_t);
+   }
+
+   if (pCounterBuffers == NULL)
+      counterBufferCount = 0;
+
+   for (uint32_t i = 0; i < counterBufferCount; ++i) {
+      if (pCounterBuffers[i] == VK_NULL_HANDLE)
+         continue;
+
+      VK_FROM_HANDLE(kk_buffer, buffer, pCounterBuffers[i]);
+      uint64_t offset = pCounterBufferOffsets ? pCounterBufferOffsets[i] : 0;
+      uint64_t addr = vk_buffer_address(&buffer->vk, offset);
+      uint32_t idx = firstCounterBuffer + i;
+
+      if (begin) {
+         params.src[idx] = addr;
+      } else {
+         params.dest[copies] = addr;
+         params.src[copies] = gfx->xfb.offsets + idx * sizeof(uint32_t);
+         ++copies;
+      }
+   }
+
+   if (copies > 0) {
+      uint64_t push = kk_pool_upload(cmd, &params, sizeof(params), 8).gpu;
+      if (push)
+         libkk_copy_xfb_counters(cmd, kk_grid_1d(copies), true, push);
+   }
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdBeginTransformFeedbackEXT(VkCommandBuffer commandBuffer,
+                                uint32_t firstCounterBuffer,
+                                uint32_t counterBufferCount,
+                                const VkBuffer *pCounterBuffers,
+                                const VkDeviceSize *pCounterBufferOffsets)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   kk_begin_end_xfb(cmd, firstCounterBuffer, counterBufferCount,
+                    pCounterBuffers, pCounterBufferOffsets, true);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdEndTransformFeedbackEXT(VkCommandBuffer commandBuffer,
+                              uint32_t firstCounterBuffer,
+                              uint32_t counterBufferCount,
+                              const VkBuffer *pCounterBuffers,
+                              const VkDeviceSize *pCounterBufferOffsets)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   kk_begin_end_xfb(cmd, firstCounterBuffer, counterBufferCount,
+                    pCounterBuffers, pCounterBufferOffsets, false);
+}
diff --git a/src/kosmickrisp/vulkan/kk_device.c b/src/kosmickrisp/vulkan/kk_device.c
index 17e9f10e6fa..972b9380efe 100644
--- a/src/kosmickrisp/vulkan/kk_device.c
+++ b/src/kosmickrisp/vulkan/kk_device.c
@@ -331,6 +331,14 @@ kk_CreateDevice(VkPhysicalDevice physicalDevice,
    if (result != VK_SUCCESS)
       goto fail_sampler_heap;
 
+   /* Transform feedback points unbound buffers' offsets at the zeroed start
+    * and counters nothing reads at the rest */
+   result = kk_alloc_bo(dev, &dev->vk.base, KK_XFB_SCRATCH_SIZE, 16,
+                        &dev->xfb_scratch);
+   if (result != VK_SUCCESS)
+      goto fail_lib;
+   memset(dev->xfb_scratch->cpu, 0, KK_XFB_SCRATCH_SIZE);
+
    if (pdev->settings.gpu_capture_immediately) {
       mtl_start_gpu_capture(dev->mtl_handle, pdev->settings.gpu_capture_dir);
       dev->gpu_capture_active = true;
@@ -340,6 +348,8 @@ kk_CreateDevice(VkPhysicalDevice physicalDevice,
 
    return VK_SUCCESS;
 
+fail_lib:
+   kk_device_finish_lib(dev);
 fail_sampler_heap:
    kk_destroy_sampler_heap(dev, &dev->samplers);
 fail_query_table:
@@ -387,6 +397,9 @@ kk_DestroyDevice(VkDevice _device, const VkAllocationCallbacks *pAllocator)
    if (dev->heap)
       kk_destroy_bo(dev, dev->heap);
 
+   if (dev->xfb_scratch)
+      kk_destroy_bo(dev, dev->xfb_scratch);
+
    if (dev->has_queue) {
       kk_queue_finish(dev, &dev->queue);
       dev->has_queue = false;
diff --git a/src/kosmickrisp/vulkan/kk_device.h b/src/kosmickrisp/vulkan/kk_device.h
index 5c964f96643..c2413b29db2 100644
--- a/src/kosmickrisp/vulkan/kk_device.h
+++ b/src/kosmickrisp/vulkan/kk_device.h
@@ -105,9 +105,18 @@ struct kk_device {
    struct kk_bo *heap;
    util_once_flag heap_init_once;
 
+   /* Zeroes, then scratch, for transform feedback, see KK_XFB_ZERO_SIZE */
+   struct kk_bo *xfb_scratch;
+
    bool gpu_capture_active;
 };
 
+/* kk_device::xfb_scratch holds KK_XFB_ZERO_SIZE bytes that stay zero, the
+ * offsets of unbound transform feedback buffers, then scratch for counters
+ * nothing reads */
+#define KK_XFB_ZERO_SIZE    64u
+#define KK_XFB_SCRATCH_SIZE 4096u
+
 VK_DEFINE_HANDLE_CASTS(kk_device, vk.base, VkDevice, VK_OBJECT_TYPE_DEVICE)
 
 static inline struct kk_physical_device *
diff --git a/src/kosmickrisp/vulkan/kk_nir_lower_descriptors.c b/src/kosmickrisp/vulkan/kk_nir_lower_descriptors.c
index 3b54ffddd8e..d6e9ac07638 100644
--- a/src/kosmickrisp/vulkan/kk_nir_lower_descriptors.c
