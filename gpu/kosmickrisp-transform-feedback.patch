diff --git a/src/kosmickrisp/libkk/kk_geometry.cl b/src/kosmickrisp/libkk/kk_geometry.cl
index dd102f9dacc..65c37306908 100644
--- a/src/kosmickrisp/libkk/kk_geometry.cl
+++ b/src/kosmickrisp/libkk/kk_geometry.cl
@@ -49,11 +49,21 @@ libkk_gs_setup_indirect(uint64_t index_buffer, constant uint *draw,
                         global struct poly_geometry_params *p,
                         global struct poly_heap *heap, uint64_t vs_outputs,
                         uint32_t index_size_B, uint32_t index_buffer_range_el,
-                        uint32_t prim, uint32_t max_indices,
-                        enum poly_gs_shape shape)
+                        uint32_t prim, uint32_t is_prefix_summing,
+                        uint32_t max_indices, enum poly_gs_shape shape)
 {
    /* Prefix summing only serves transform feedback */
    poly_gs_setup_indirect(index_buffer, draw, vp, p, heap, vs_outputs,
                           index_size_B, index_buffer_range_el, prim,
-                          false /* is_prefix_summing */, max_indices, shape);
+                          is_prefix_summing, max_indices, shape);
+}
+
+/* Prefix sums the GS count buffer, one workgroup per count word, so the GS
+ * knows where each input primitive's transform feedback output goes */
+KERNEL(1024)
+libkk_prefix_sum_geom(constant struct poly_geometry_params *p)
+{
+   local uint scratch[32];
+   poly_prefix_sum(scratch, p->count_buffer, p->input_primitives,
+                   p->count_buffer_stride / 4, cl_group_id.x, 1024);
 }
diff --git a/src/kosmickrisp/libkk/kk_query.cl b/src/kosmickrisp/libkk/kk_query.cl
index 3c2e5f056ec..7295c75cd67 100644
--- a/src/kosmickrisp/libkk/kk_query.cl
+++ b/src/kosmickrisp/libkk/kk_query.cl
@@ -94,3 +94,27 @@ libkk_copy_queries(global uint32_t *availability, global uint64_t *results,
       vk_write_query(dst, reports_per_query, flags, available);
    }
 }
+
+KERNEL(4)
+libkk_copy_xfb_counters(constant struct libkk_xfb_counter_copy *push)
+{
+   unsigned i = cl_local_id.x;
+
+   *(push->dest[i]) = push->src[i] ? *(push->src[i]) : 0;
+}
+
+/* vkCmdDrawIndirectByteCountEXT: the vertex count is the bytes captured past
+ * counter_offset over the vertex stride */
+KERNEL(1)
+libkk_draw_from_byte_count(global uint32_t *out_draw,
+                           constant uint32_t *byte_count, uint32_t counter_offset,
+                           uint32_t vertex_stride, uint32_t instance_count,
+                           uint32_t first_instance)
+{
+   int32_t bytes = (int32_t)(*byte_count) - (int32_t)counter_offset;
+
+   out_draw[0] = max(bytes, 0) / vertex_stride; /* vertexCount */
+   out_draw[1] = instance_count;
+   out_draw[2] = 0;                           /* firstVertex */
+   out_draw[3] = first_instance;
+}
diff --git a/src/kosmickrisp/libkk/kk_query.h b/src/kosmickrisp/libkk/kk_query.h
index 56887401c5b..039d4645a1f 100644
--- a/src/kosmickrisp/libkk/kk_query.h
+++ b/src/kosmickrisp/libkk/kk_query.h
@@ -16,6 +16,12 @@ struct libkk_imm_write {
    uint32_t value;
 };
 
+/* Transform feedback counters: dest[i] = src[i] ? *src[i] : 0 */
+struct libkk_xfb_counter_copy {
+   DEVICE(uint32_t) dest[4];
+   DEVICE(uint32_t) src[4];
+};
+
 #define LIBKK_QUERY_UNAVAILABLE (uint64_t)((int64_t)-1)
 
 #endif /* KK_QUERY_H */
diff --git a/src/kosmickrisp/vulkan/kk_cmd_buffer.h b/src/kosmickrisp/vulkan/kk_cmd_buffer.h
index 20e585458b8..d022e2303d7 100644
