+/* Metal has no transform feedback, a GS captures it. When a pipeline captures
+ * it from its VS or TES, a GS that passes their output through stands in. The
+ * shader feeding it is linked to the FS and its IO lowered. */
+static nir_shader *
+kk_build_xfb_passthrough_gs(nir_shader *last, nir_shader *tcs,
+                            const struct vk_graphics_pipeline_state *state)
+{
+   const nir_xfb_info *xfb = last->xfb_info;
+   size_t key_size = poly_passthrough_gs_key_size(xfb->output_count);
+   struct poly_passthrough_gs_key *key = calloc(1, key_size);
+   if (key == NULL)
+      return NULL;
+
+   if (last->info.stage == MESA_SHADER_TESS_EVAL) {
+      bool points = last->info.tess.point_mode ||
+                    (tcs != NULL && tcs->info.tess.point_mode);
+      enum tess_primitive_mode mode = last->info.tess._primitive_mode;
+      if (mode == TESS_PRIMITIVE_UNSPECIFIED && tcs != NULL)
+         mode = tcs->info.tess._primitive_mode;
+
+      key->prim = points                           ? MESA_PRIM_POINTS
+                  : mode == TESS_PRIMITIVE_ISOLINES ? MESA_PRIM_LINES
+                                                    : MESA_PRIM_TRIANGLES;
+   } else {
+      /* The pipeline's topology names the class, which is all a dynamic one
+       * may change; adjacency draws are unrolled to lists for it */
+      key->prim = u_reduced_prim(
+         vk_topology_to_mesa(state->ia->primitive_topology));
+   }
+
+   key->outputs = last->info.outputs_written;
+   key->clip_distance_array_size = last->info.clip_distance_array_size;
+   key->cull_distance_array_size = last->info.cull_distance_array_size;
+
+   nir_shader_intrinsics_pass(last, gather_output_layout, nir_metadata_all,
+                              key);
+   for (unsigned i = 0; i < NUM_TOTAL_VARYING_SLOTS; i++) {
+      if (key->output_components[i] == 0)
+         key->output_components[i] = 4;
+      if (key->output_types[i] == nir_type_invalid)
+         key->output_types[i] = nir_type_uint32;
+   }
+
+   typed_memcpy(key->xfb_stride, last->info.xfb_stride,
+                ARRAY_SIZE(key->xfb_stride));
+   memcpy(&key->xfb_info, xfb, nir_xfb_info_size(xfb->output_count));
+
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_GEOMETRY, &kk_nir_options, "kk-xfb-passthrough-gs");
+   poly_nir_passthrough_gs(&b, key);
+   free(key);
+
+   nir_shader *gs = b.shader;
+   gs->info.io_lowered = true;
+   gs->info.prev_stage = last->info.stage;
+   gs->info.next_stage = MESA_SHADER_FRAGMENT;
+   nir_shader_gather_info(gs, nir_shader_get_entrypoint(gs));
+   return gs;
+}
