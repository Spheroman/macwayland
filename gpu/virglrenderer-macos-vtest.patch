diff --git a/src/virgl_util.c b/src/virgl_util.c
index b770a0a..a224203 100644
--- a/src/virgl_util.c
+++ b/src/virgl_util.c
@@ -29,6 +29,11 @@
 #include "virgl_util.h"
 
 #include <errno.h>
+#ifdef __APPLE__
+#include <fcntl.h>
+#include <stdio.h>
+#include <sys/stat.h>
+#endif
 #ifdef HAVE_EVENTFD_H
 #include <sys/eventfd.h>
 #endif
@@ -88,7 +93,7 @@ bool equal_func(const void *key1, const void *key2)
 
 bool has_eventfd(void)
 {
-#ifdef HAVE_EVENTFD_H
+#if defined(HAVE_EVENTFD_H) || defined(__APPLE__)
    return true;
 #else
    return false;
@@ -99,6 +104,26 @@ int create_eventfd(unsigned int initval)
 {
 #ifdef HAVE_EVENTFD_H
    return eventfd(initval, EFD_CLOEXEC | EFD_NONBLOCK);
+#elif defined(__APPLE__)
+   /* No eventfds on macOS. A FIFO opened for reading and writing is one fd
+    * that is both written to and polled (and can be passed to another
+    * process, as vtest does), as an eventfd is; it's unlinked at once.
+    * Each write of 8 bytes is one wakeup to read; flush_eventfd drains. */
+   char path[64];
+   static unsigned counter;
+   for (int tries = 0; tries < 16; tries++) {
+      snprintf(path, sizeof(path), "/tmp/virgl-efd-%d-%u", (int)getpid(),
+               __atomic_fetch_add(&counter, 1, __ATOMIC_RELAXED));
+      if (mkfifo(path, 0600) == 0)
+         break;
+      if (errno != EEXIST)
+         return -1;
+   }
+   int fd = open(path, O_RDWR | O_NONBLOCK | O_CLOEXEC);
+   unlink(path);
+   if (fd >= 0 && initval)
+      write_eventfd(fd, initval);
+   return fd;
 #else
    (void)initval;
    return -1;
